{
"Astral_radiator_wrc17": {
	"information":{
		"name":"WRC+ Radiator",
		"value":50
	},
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_rad_wrc17", ["Astral_rad"]],
		["Astral_rad_duct", ["Astral_rad","Astral_radduct"]],
		["Astral_rad_coolant", ["Astral_engine","Astral_chassis_F"]],
		["Astral_rad_pipe_wrc17", ["Astral_chassis_F","Astral_engine"]],
	],
	"slotType" : "Astral_radiator",
	"props": [
		["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"]
		//--Radiator Fan--
		["radiatorFanSpin", "Astral_rad_fan_l_wrc17", "rad1","rad2","rad3",  {"x":-28, "y":0, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -360, 360, 0, 0.4],
		["radiatorFanSpin", "Astral_rad_fan_r_wrc17", "rad2","rad1","rad4",  {"x":-13, "y":0, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -360, 360, 0, 0.4],
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"nodeMaterial":"|NM_METAL"},
		{"collision":true},
		{"selfCollision":false},
		//--Engine--
		//radiator
		{"group":["Astral_rad"]},
		{"nodeWeight":1.25},
		{"chemEnergy":200,"burnRate":0.4,"flashPoint":250,"specHeat":0.8,"smokePoint":150,"selfIgnitionCoef":false},
		["rad1",  0.347, -1.848, 0.531, {"engineGroup":["radiator"]}],
		["rad2", -0.347, -1.848, 0.531, {"engineGroup":["radiator"]}],
		["rad3",  0.441, -1.745, 0.199, {"engineGroup":["radiator"], "selfCollision":false}],
		["rad4", -0.441, -1.745, 0.199, {"engineGroup":["radiator"], "selfCollision":false}],
		["radr",      0, -1.935, 0.325, {"selfCollision":false, "collision":false}],
		{"chemEnergy":false,"burnRate":false,"flashPoint":false, "specHeat": false,"selfIgnitionCoef":false,"smokePoint":false,"baseTemp":false,"conductionRadius":false}
		//rad duct
		{"nodeWeight":0.4},
		{"group":["Astral_radduct"]},
		["rductr", -0.411, -1.484, 0.781],
		["rductl",  0.411, -1.484, 0.781],
		{"group":""},
	],
	"beams": [
		["id1:", "id2:"],
		{"deformLimitExpansion":1.2},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Radiator--
		//shape
		{"breakGroup":""}
		{"beamSpring":1201000,"beamDamp":125},
		{"beamDeform":3500,"beamStrength":"FLT_MAX"},
		{"deformGroup":"radiator_damage", "deformationTriggerRatio":0.001},
		["rad1", "rad2"],
		["rad2", "rad3"],
		["rad3", "rad4"],
		["rad4", "rad1"],
		["rad1", "rad3"],
		["rad4", "rad2"],
		//rigidifier
		{"beamDeform":2500,"beamStrength":"FLT_MAX"},
		["radr", "rad1"],
		["radr", "rad2"],
		["radr", "rad3"],
		["radr", "rad4"],
		//radiator connect
		{"beamSpring":1001000,"beamDamp":100},
		{"beamDeform":2500,"beamStrength":65500},
		{"breakGroup":["Astral_Radiator"]}
		["rad2", "br1r"],
		["rad2", "chs3r"],
		["rad2", "br1l"],
		["rad2", "chs3l"],
		["rad4", "br1r"],
		["rad4", "br1r"],
		["rad4", "br1l"],
		["rad4", "br1l"],
		//*
		["rad1", "br1l"],
		["rad1", "chs3l"],
		["rad1", "br1r"],
		["rad1", "chs3r"],
		["rad3", "br1l"],
		["rad3", "br1l"],
		["rad3", "br1r"],
		["rad3", "br1r"],
		//radiator duct
		{"beamSpring":15000,"beamDamp":150},
		{"beamDeform":850,"beamStrength":"FLT_MAX"},
		["rductr", "rad1"],
		["rductr", "rad2"],
		["rductr", "rad3"],
		["rductr", "rad4"],
		//*
		["rductl", "rad1"],
		["rductl", "rad2"],
		["rductl", "rad3"],
		["rductl", "rad4"],
		{"breakGroup":[""]}
		//duct damping
		{"beamSpring":0,"beamDamp":150},
		["rductr", "a84"],
		["rductr", "a85"],
		["rductr", "a88"],
		["rductr", "br1r"],
		//*
		["rductl", "a87"],
		["rductl", "a86"],
		["rductl", "a91"],
		["rductl", "br1l"],
		//limiters
		{"beamPrecompression":0.9, "beamType":"|SUPPORT", "beamLongBound":4},
		{"beamSpring":451000,"beamDamp":50},
		{"beamDeform":95500,"beamStrength":155500},
		{"optional":true}
		["rductr", "hd1r"],
		["rductr", "hd2r"],
		["rductr", "hd3r"],
		["rductr", "hd4r"],
		//*
		["rductl", "hd1l"],
		["rductl", "hd2l"],
		["rductl", "hd3l"],
		["rductl", "hd4l"],
		{"optional":false}
		{"deformationTriggerRatio":"", "deformGroup":""},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
	"triangles": [
		["id1:", "id2:", "id3:"],
		{"groundModel":"metal"},
		//--Radiator Collision--
		{"dragCoef":22},
		["rad1", "rad2", "rad3"],
		["rad4", "rad3", "rad2"],
		{"dragCoef":0},
		{"liftCoef":0,"stallAngle":0}
	],
	"mainEngine":{
		"radiatorArea":"$=$components.engine.radiatorAreaOffset == nil and 0.38 or 0.38+$components.engine.radiatorAreaOffset",
		"radiatorEffectiveness":"$=$components.engine.radiatorEffectivenessOffset == nil and 20500 or 20500+$components.engine.radiatorEffectivenessOffset",
		"coolantVolume":10,
		"radiatorFanType":"electric",
		"radiatorFanTemperature":92,
		"radiatorFanMaxAirSpeed":3.8,
		"thermostatTemperature":85,
		"radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Electric_05",
		"radiatorFanVolume": 0.65,
		"deformGroups_radiator":["radiator_damage"],
	}
},
