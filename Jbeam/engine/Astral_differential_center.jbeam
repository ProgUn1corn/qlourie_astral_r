{
"Astral_differential_center_e": {
	"information":{
		"authors":"Un1corn",
		"name":"Active Center Differential",
		"value":2500
	},
	"slotType" : "Astral_transfercase",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$torquesplit", "range", "", "Differentials", 0.57, 0.57, 0.63, "Torque Split", "Rear power bias",{"subCategory": "Active Map 1.Master", "stepDis":6, "minDis":57,"maxDis":63}]
		["$minLock_C", "range", "", "Differentials", 0.20, 0, 0.5, "Minimum Lock Factor", "Minimum differential lock factor when calculating maps", {"minDis":0, "maxDis":50, "subCategory":"Active Map 1.Master"}],
		["$lockThrottle_C", "range", "", "Differentials", 0.9, 0.4, 1, "Throttle Lock Threshold", "Throttle input percentage where max lock is applied", {"minDis":40, "maxDis":100, "subCategory":"Active Map 2.Throttle"}],
		["$lockBrake_C", "range", "", "Differentials", 0.75, 0.4, 1, "Brake Lock Threshold", "Brake input percentage where max lock is applied", {"minDis":40, "maxDis":100, "subCategory":"Active Map 3.Brake"}],
		["$lockThrottleStart_C", "range", "", "Differentials", 0.3, 0, 0.6, "Throttle Lock Start", "Throttle input percentage where where active map starts to calculate", {"minDis":0, "maxDis":60, "subCategory":"Active Map 2.Throttle"}],
		["$lockBrakeStart_C", "range", "", "Differentials", 0.15, 0, 0.6, "Brake Lock Start", "Brake input percentage where where active map starts to calculate", {"minDis":0, "maxDis":60, "subCategory":"Active Map 3.Brake"}],
		["$steerRatio_C", "range", "", "Differentials", 1, 0, 1, "Steering Factor", "The amount of steering input affects lock and bias", {"minDis":0, "maxDis":100, "subCategory":"Active Map 5.Steering"}],
		["$speedMap_C", "range", "", "Differentials", -1080, -2000, 0, "Speed Map Cut", "Reduction of speed map that affects steering factor", {"minDis":0, "maxDis":100, "subCategory":"Active Map 5.Steering"}],
		["$leftAStart_C", "range", "", "Differentials", 0.15, 0, 0.5, "L.foot Input Threshold", "The threshold where left foot input starts to affect main map", {"minDis":0, "maxDis":50, "subCategory":"Active Map 4.L.foot"}],
		["$leftThrottleGain_C", "range", "", "Differentials", 1, 0, 1, "L.foot Throttle Gain", "Gain of throttle input that affects corresponding main map", {"minDis":0, "maxDis":100, "subCategory":"Active Map 4.L.foot"}],
		["$leftBrakeGain_C", "range", "", "Differentials", 1, 0, 1, "L.foot Brake Gain", "Gain of brake input that affects corresponding main map", {"minDis":0, "maxDis":100, "subCategory":"Active Map 4.L.foot"}],
		["$hbRelease", "range", "", "Differentials", 0.4, 0, 1, "Handbrake Release", "The handbrake thershold for disconnecting front and rear", {"minDis":0, "maxDis":100, "subCategory":"Active Map 1.Master"}],
		["$preload_C", "range", "Nm", "Differentials", 180, 60, 300, "Active Preload Torque", "The max torque that can be provided by the active system additional to input torque", {"minDis":60, "maxDis":300, "stepDis":5, "subCategory":"Active Map 1.Master"}],
		["$coastStart", "range", "", "Differentials", 0.05, 0, 0.15, "Coast Map Threshold", "Max input percentage where coast map is still applied", {"minDis":0, "maxDis":15, "stepDis":1, "subCategory":"Active Map 1.Master"}],
	],
	"controller": [
		["fileName"],
		["eCenterDiff", {"name":"activeCenterDiff"}],
		//["driveModes", {"name":"centerLock"}],
	],
	"activeCenterDiff":{
		"type":"active",
		"transfercaseName":"transfercase",
		"lockMap":{
			"minLock":"$minLock_C"
			"lockThrottle":"$lockThrottle_C"
			"lockBrake":"$lockBrake_C"
			"lockThrottleStart":"$lockThrottleStart_C"
			"lockBrakeStart":"$lockBrakeStart_C"
			"steerRatio":"$steerRatio_C"
			"speedMap":"$speedMap_C"
			"leftThreshold":"$leftAStart_C"
			"leftThrottleGain":"$leftThrottleGain_C"
			"leftBrakeGain":"$leftBrakeGain_C"
			"coastStart":"$coastStart"
			"rearBias":"$torquesplit"
			"hbRelease":"$hbRelease"
			"preload":"$preload_C"
			"finalDrive":"$=$components.diff.finaldrive"
		}
	},
	"centerLock": {
		"enabledModes":["1", "2", "3", "4"],
		"defaultMode": "2",
		"modes": {
			"1": {
				"name": "Center Lock 1",
				"order": 1,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLock":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_open"}]
				]
			},
			"2": {
				"name": "Center Lock 2",
				"order": 2,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLock":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_lsd"}]
				]
			},
			"3": {
				"name": "Center Lock 3",
				"order": 3,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLock":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_closed"}]
				]
			},
			"4": {
				"name": "Center Lock 4",
				"order": 4,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLock":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_lsd_active"}]
				]
			},
		}
	},
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["differential", "transfercase", "gearbox", 1, {"deformGroups":["transfercase"], "diffType":"lsd", "lsdPreload":0, "lsdLockCoef":0.5, "lsdRevLockCoef":0.38, "diffTorqueSplit":0.5, "friction":0.50, "dynamicFriction":0.00032, "torqueLossCoef": 0.022, "uiName":"Center Diff", "defaultVirtualInertia":0.25}]  //overridden by Lua
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"nodeMaterial":"|NM_METAL"},
		{"collision":true},
		{"selfCollision":true},
		{"nodeWeight":22},
		//--Transfer Case--
		{"group":["Astral_transfercase"]},
		["tra", 0.022, -1.128, 0.2],
	],
	"beams": [
		["id1:", "id2:"],
		{"deformLimitExpansion":1.2},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Transfer Case--
		{"breakGroup":""}
		{"beamSpring":8501000,"beamDamp":850},
		{"beamDeform":35000,"beamStrength":"FLT_MAX"},
		{"deformGroup":"transfercase", "deformationTriggerRatio":0.001},
		["tra","eg0"],
		["tra","eg1"],
		["tra","eg2"],
		["tra","eg3"],
		["tra","eg6"],
		["tra","eg7"],
		["tra","ftral"],
		["tra","ftrar"],
		{"deformGroup":"", "deformationTriggerRatio":0},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
},
"Astral_differential_center_m": {
	"information":{
		"name":"1.5-Way Clutch-Type LSD",
		"value":2500
	},
	"slotType" : "Astral_transfercase",
	"slots": [
		["type", "default", "description"],
		["Astral_ramp_C","Astral_ramp_C_4525","Center Ramp Set", {"coreSlot":true}]
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$torquesplit", "range", "", "Differentials", 0.50, 0.3, 0.7, "Torque Split", "Rear power bias",{"subCategory": "Center", "stepDis": 3, "minDis":30,"maxDis":70}]
		["$lsdpreload_C", "range", "Nm", "Differentials", 20, 0, 120, "Preload Adjuster", "Initial locking torque between axles", {"stepDis":5, "subCategory":"Center"}],
		["$frictionFace_C", "range", "Faces", "Differentials", 6, 4, 6, "Friction Face", "Adjust locking ratio with different number of pads", {"minDis":8, "maxDis":12, "stepDis":2, "subCategory":"Center"}]
		["$hbRelease", "range", "", "Differentials", 0.4, 0, 1, "Handbrake Release", "The handbrake thershold for disconnecting front and rear", {"minDis":0, "maxDis":100, "subCategory":"Center"}],
	],
	"controller": [
		["fileName"],
		["eCenterDiff", {"name":"passiveCenterDiff"}],
	],
	"passiveCenterDiff":{
		"type":"passive",
		"transfercaseName":"transfercase",
		"lockMap":{
			"lock":"$=$components.diff.clock"
			"revLock":"$=$components.diff.crevlock"
			"preload":"$=$lsdpreload_C*(1+($frictionFace_C-6)*0.048)"
			"rearBias":"$torquesplit"
			"hbRelease":"$hbRelease"
		}
	},
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["differential", "transfercase", "gearbox", 1, {"deformGroups":["transfercase"], "diffType":"lsd", "lsdPreload":"$=($lsdpreload_C*(1+($frictionFace_C-6)*0.048))", "lsdLockCoef":"$=$components.diff.clock", "lsdRevLockCoef":"$=$components.diff.crevlock", "diffTorqueSplit":"$=$torquesplit", "friction":0.35, "dynamicFriction":0.00030, "torqueLossCoef": 0.020, "uiName":"Center Diff", "defaultVirtualInertia":0.25}]
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"nodeMaterial":"|NM_METAL"},
		{"collision":true},
		{"selfCollision":true},
		{"nodeWeight":20},
		//--Transfer Case--
		{"group":["Astral_transfercase"]},
		["tra", 0.022, -1.158, 0.2],
	],
	"beams": [
		["id1:", "id2:"],
		{"deformLimitExpansion":1.2},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Transfer Case--
		{"breakGroup":""}
		{"beamSpring":8501000,"beamDamp":650},
		{"beamDeform":35000,"beamStrength":"FLT_MAX"},
		{"deformGroup":"transfercase", "deformationTriggerRatio":0.001},
		["tra","eg0"],
		["tra","eg1"],
		["tra","eg2"],
		["tra","eg3"],
		["tra","eg6"],
		["tra","eg7"],
		["tra","ftral"],
		["tra","ftrar"],
		{"deformGroup":"", "deformationTriggerRatio":0},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
},
"Astral_ramp_C_4525": {
	"information":{
		"name":"45/25 (Coupled with 45/35)",
		"value":1000
	},
	"slotType" : "Astral_ramp_C",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$coastRamp_C", "range", "Degrees", "Differentials", 35, 25, 35, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":10, "subCategory":"Center"}]
	],
	"components": {
		"diff":{//35, 8+8 as 100% in relavent, about 65% lock
			"clock":"$=(1/tan(54*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_C-8)*0.0947)",
			"crevlock":"$=(1/tan($coastRamp_C*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_C-8)*0.0947)"
		},
	}
},
"Astral_ramp_C_d": {
	"information":{
		"name":"Adjustable Debug Ramp",
		"value":1000
		"isAuxiliary":true
	},
	"slotType" : "Astral_ramp_C",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$powerRamp_C", "range", "Degrees", "Differentials", 54, 25, 90, "Coast Ramp Angle", "Adjust power side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Center"}]
		["$coastRamp_C", "range", "Degrees", "Differentials", 25, 25, 90, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Center"}]
	],
	"components": {
		"diff":{//35, 8+8 as 100% in relavent, about 65% lock
			"flock":"$=(1/tan($powerRamp_C*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_F-8)*0.0947)",
			"frevlock":"$=(1/tan($coastRamp_C*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_F-8)*0.0947)",
		},
	}
},
