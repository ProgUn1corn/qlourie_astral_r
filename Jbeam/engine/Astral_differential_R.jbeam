{
"Astral_differential_R_race": {
	"information":{
		"name":"1.5-Way Clutch-Type LSD",
		"value":1500
	},
	"slotType" : "Astral_differential_R",
	"slots2": [
		["name"               , "allowTypes"           , "denyTypes", "default"                  , "description"],
		["Astral_driveshaft"  , ["Astral_driveshaft"]  , []         , "Astral_driveshaft"        , "Driveshaft"],
		["Astral_halfshafts_R", ["Astral_halfshafts_R"], []         , "Astral_halfshafts_R"      , "Rear Halfshafts"],
		["Astral_finaldrive_R", ["Astral_finaldrive_R"], []         , "Astral_finaldrive_R_wrc17", "Rear Final Drive", {"coreSlot":true}],
		["Astral_ramp_R"      , ["Astral_ramp_R"]      , []         , "Astral_ramp_R_4485"       , "Rear Ramp Set"   , {"coreSlot":true}]
	],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_diff", ["Astral_sub_R"]],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$lsdpreload_R", "range", "Nm", "Differentials", 50, 0, 120, "Preload Adjuster", "Initial locking torque between left and right wheels", {"stepDis":5, "subCategory":"Rear"}]
		["$frictionFace_R", "range", "Faces", "Differentials", 6, 4, 6, "Friction Face", "Adjust locking ratio with different number of pads", {"minDis":8, "maxDis":12, "stepDis":2, "subCategory":"Rear"}]
	],
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["differential", "differential_R", "driveshaft", 1, {"diffType":"lsd", "lsdPreload":"$=$lsdpreload_R*(1+($frictionFace_R-6)*0.048)", "lsdLockCoef":"$=$components.diff.rlock", "lsdRevLockCoef":"$=$components.diff.rrevlock", "uiName":"Rear Differential", "defaultVirtualInertia":0.25}]
	],
	"differential_R": {
		"friction": 3.01,
		"dynamicFriction": 0.00124,
		"torqueLossCoef": 0.0256,
	},
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"nodeMaterial":"|NM_METAL"},
		{"collision":false},
		{"selfCollision":false},
		//--Rear Drivetrain--
		{"nodeWeight":10},
		{"group":["Astral_transfercase"]},
		["rtrar", -0.114, 1.222, 0.200],
		["rtral",  0.114, 1.222, 0.200],
		{"nodeWeight":12},
		["rtra", 0, 1.066 0.204],
	],
	"beams": [
		["id1:", "id2:"],
		{"deformLimitExpansion":1.2},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Rear Drivetrain--
		//diff
		{"beamSpring":4501000,"beamDamp":250},
		{"beamDeform":45000,"beamStrength":"FLT_MAX"},
		["rtral", "rtrar"],
		["rtral", "rtra"],
		["rtrar", "rtra"],

		//mount to chassis
		{"beamSpring":2501000,"beamDamp":250},
		{"optional":true}
		{"deformGroup":"differential_R", "deformationTriggerRatio":0.001}
		["rtra", "rx1"],
		//
		//["rtrar","rx4r"],
		["rtrar", "rx3r"],
		["rtrar", "rx2r"],
		["rtrar", "rx1r"],
		//["rtrar","rx4l"],
		["rtrar", "rx3l"],
		["rtrar", "rx2l"],
		["rtrar", "rx1l"],
		["rtrar", "rx1"],
		["rtra" , "rx1r"],
		["rtra" , "rx2r"],
		["rtra" , "chs2r"],
		//*
		//["rtral","rx4l"],
		["rtral", "rx3l"],
		["rtral", "rx2l"],
		["rtral", "rx1l"],
		//["rtral","rx4r"],
		["rtral", "rx3r"],
		["rtral", "rx2r"],
		["rtral", "rx1r"],
		["rtral", "rx1"],
		["rtra" , "rx1l"],
		["rtra" , "rx2l"],
		["rtra" , "chs2l"],
		{"deformGroup":"", "deformationTriggerRatio":""}
		{"dampCutoffHz":""},
		{"optional":false}
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
},
"Astral_ramp_R_h": {
	"information":{
		"name":"38/80",
		"value":1000
	},
	"slotType" : "Astral_ramp_R",
	"components": {
		"diff":{ //35, 8+8 as 100% in relavent, about 65% lock
			"rlock":"$=(1/tan(38*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)",
			"rrevlock":"$=(1/tan(80*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)"
		},
	}
},
"Astral_ramp_R_m": {
	"information":{
		"name":"44/80",
		"value":1000
	},
	"slotType" : "Astral_ramp_R",
	"components": {
		"diff":{ //35, 8+8 as 100% in relavent, about 65% lock
			"rlock":"$=(1/tan(44*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)",
			"rrevlock":"$=(1/tan(80*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)"
		},
	}
},
"Astral_ramp_R_l": {
	"information":{
		"name":"50/80",
		"value":1000
	},
	"slotType" : "Astral_ramp_R",
	"components": {
		"diff":{ //35, 8+8 as 100% in relavent, about 65% lock
			"rlock":"$=(1/tan(50*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)",
			"rrevlock":"$=(1/tan(80*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_R-8)*0.0947)"
		},
	}
},
"Astral_ramp_R_d": {
	"information":{
		"name":"Adjustable Debug Ramp",
		"value":1000
		"isAuxiliary":true
	},
	"slotType" : "Astral_ramp_R",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$powerRamp_R", "range", "Degrees", "Differentials", 35, 30, 65, "Power Ramp Angle", "Adjust power side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Rear"}]
		["$coastRamp_R", "range", "Degrees", "Differentials", 90, 50, 90, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Rear"}]
	],
	"components": {
		"diff":{//35, 8+8 as 100% in relavent, about 65% lock
			"flock":"$=(1/tan($powerRamp_R*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_F-8)*0.0947)",
			"frevlock":"$=(1/tan($coastRamp_R*pi/180))/(1/tan(35*pi/180))*0.325*(1+($frictionFace_F-8)*0.0947)",
		},
	}
},
