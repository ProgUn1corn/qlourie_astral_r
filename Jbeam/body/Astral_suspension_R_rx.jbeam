{
"Astral_group_R_rx": {
	"information":{
		"authors":"Un1corn",
		"name":"CTM MRX80",
		"value":3200,
	},
	"slotType" : "Astral_group_R",
	"slots2" : [
		["name"                      , "allowTypes"                  , "denyTypes", "default"                      , "description"],
		["Astral_hubs_R"             , ["wheel_R_5"]                 , []         , "Astral_hubs_R_rx"             , "Rear Wheels", {"nodeOffset":{"x":"$=0.297+$TrackRear", "y":1.26, "z":0.088}}],
		["Astral_brake_R"            , ["Astral_brake_R"]            , []         , "Astral_brake_R_355"           , "Brake Disc" , {"nodeOffset":{"x":0, "y":1.26, "z":0.088}}],
		["Astral_brake_duct_R_rally2", ["Astral_brake_duct_R_rally2"], []         , "Astral_brake_duct_R_no_rally2", "Rear Duct"  , {"coreSlot":true}],
		["Astral_spring_R_rx"        , ["Astral_spring_R_rx"]        , []         , "Astral_spring_R_rx_285"       , "Spring"],
		["Astral_shim_R_rx"          , ["Astral_shim_R_rx"]          , []         , "Astral_shim_R_rx_l"           , "Shim Stacks", {"coreSlot":true}]
	],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_arm_r8", ["Astral_arm_R"]],
		["Astral_rod_r8", ["Astral_arm_R"]],
		["Astral_arb_r8", ["Astral_arb2_R"]],
		["Astral_hub_r8", ["Astral_hub_RR","Astral_hub_RL"]],
		["Astral_damper_platform_r8", ["Astral_damper_R"]],
		["Astral_damper_piston_r8", ["Astral_piston_R"]],
		["Astral_trans_r8", ["axr_L","axr_R","Astral_diff","Astral_arm_R"]],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_stop_R", "range", "Clicks", "Suspension - Dampers and Springs", 10000, 8000, 12000, "HBS Damping", "HBS damping stiffness", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampRateRebound_stop_R", "range", "Clicks", "Suspension - Dampers and Springs", 4000, 2000, 6000, "HRS Damping", "HRS damping stiffness", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampPos_hystop_R", "range", "mm", "Suspension - Dampers and Springs", 0.035, 0.032, 0.045, "HBS Travel", "Adjust hydraulic bump stop's travel length", {"stepDis":1,"minDis":32,"maxDis":45,"subCategory":"Rear Damper Internal"}],
		["$dampGas_R", "range", "PSI", "Suspension - Dampers and Springs", 200, 150, 250, "Gas Internal Pressure", "The pressure of nitrogen gas inside damper", {"stepDis":25,"subCategory":"Rear Damper Internal"}],
		["$RideHeightOffsetRear", "range", "mm", "Suspension - Dampers and Springs", 0.015, 0.003, 0.036, "Spring Collar Offset", "Changes the platform height", {"stepDis":3,"minDis":-12,"maxDis":21,"subCategory":"Rear Damper - 3+2-Way"}], //rg1 node from the ground about 120mm
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Hub--
		//hub mounting points for control arm
		{"nodeWeight":8.5},
		["rh1r", -0.749, 1.341, -0.09, {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh1l",  0.749, 1.341, -0.09, {"group":["Astral_hub_RL","Astral_arm_R"]}],
		//strut attach
		{"nodeWeight":4.75},
		["rh2r", -0.5708, 1.3512, 0.18, {"group":["Astral_hub_RR","Astral_damper_R"]}],
		["rh2l",  0.5708, 1.3512, 0.18, {"group":["Astral_hub_RL","Astral_damper_R"]}],
		//toe link
		["rh3r", -0.745, 1.151, "$=-0.0752+$Bumpsteer_R", {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh3l",  0.745, 1.151, "$=-0.0752+$Bumpsteer_R", {"group":["Astral_hub_RL","Astral_arm_R"]}],
		//brake caliper
		{"nodeWeight":"$=4.0*$brakeThickness_R"},
		["rh5r", -0.788, 1.101, 0.074, {"group":["Astral_hub_RR","Astral_duct_R"]}],
		["rh5l",  0.788, 1.101, 0.074, {"group":["Astral_hub_RL","Astral_duct_R"]}],

		//--Arm--
		//arb end link
		{"nodeWeight":1.25},
		{"group":["Astral_arb2_R"]},
		["rarb3r", -0.438, 1.3599, 0.0268],
		["rarb3l",  0.438, 1.3599, 0.0268],

		//--Strut--
		//damper top point
		{"group":["Astral_piston_R","Astral_spring_R","Astral_chassis_R"]},
		{"nodeWeight":10.5},
		["rs1r", -0.55, 1.337, 0.797],
		["rs1l",  0.55, 1.337, 0.797],
		//lower spring collar
		{"group":["Astral_helper_R"]},
		{"nodeWeight":0.4},
		{"selfCollision":false},
		["rcl1r", -0.5692, 1.35, 0.227],
		["rcl1l",  0.5692, 1.35, 0.227],
		//piston outer shell to mount LRS
		{"group":["Astral_piston_R"]},
		{"nodeWeight":0.1},
		["rps1r", -0.5615, 1.3449, 0.455],
		["rps1l",  0.5615, 1.3449, 0.455],
		//mass
		{"group":[""]},
		{"nodeWeight":0.1},
		["rmassr", -0.5723, 1.3522, 0.135],
		["rmassl",  0.5723, 1.3522, 0.135],
		//damper end
		{"nodeWeight":3.95},
		{"group":["Astral_damper_R"]},
		["rs2r", -0.5764, 1.355, 0.0141],
		["rs2l",  0.5764, 1.355, 0.0141],
		//damper flexbodu stuff
		{"collision":false},
		{"nodeWeight":0.1},
		{"group":["Astral_damper_R"]},
		["rs3r", -0.455, 1.385, 0.145, {"selfCollision":false}],
		["rs3l",  0.455, 1.385, 0.145, {"selfCollision":false}],
		{"group":[""]},
		{"collision":true},
		{"selfCollision":true},
	],
	"rails": {
		//strut shaft rail
		"strut_RR":{"links:":["rs2r", "rs1r"], "broken:":[], "looped":false, "capped":true},
		"strut_RL":{"links:":["rs2l", "rs1l"], "broken:":[], "looped":false, "capped":true},
		//strut body shell
		"strut2_RR":{"links:":["rs2r", "rh2r"], "broken:":[], "looped":false, "capped":true},
		"strut2_RL":{"links:":["rs2l", "rh2l"], "broken:":[], "looped":false, "capped":true},
		//arb mounting rail
		"arb_RR":{"links:":["rh1r", "rx2r"], "broken:":[], "looped":false, "capped":true},
		"arb_RL":{"links:":["rh1l", "rx2l"], "broken:":[], "looped":false, "capped":true},
	},
	"slidenodes": [
		["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
		//attach strut body to strut shaft rail
		["rh2r", "strut_RR", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["rh2l", "strut_RL", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["rcl1r", "strut_RR", true, true, 0.0, 2001000, "FLT_MAX", "FLT_MAX"],
		["rcl1l", "strut_RL", true, true, 0.0, 2001000, "FLT_MAX", "FLT_MAX"],
		//spring collar
		["rhe1r", "strut_RR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		["rhe1l", "strut_RL", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		//piston
		["rps1r", "strut_RR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["rps1l", "strut_RL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//mass
		["rmassr", "strut2_RR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["rmassl", "strut2_RL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//arb mounting point
		["rarb3r", "arb_RR", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"],
		["rarb3l", "arb_RL", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"]
	],
	"beams": [
		["id1:", "id2:"]
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Hub and Wheel--
		//camber
		{"beamSpring":3501000,"beamDamp":180},
		{"breakGroup":"wheel_RR"},
		["rh2r","rw1rr", {"precompressionRange":"$=$CamberRear*2.02+0.0066","beamPrecompressionTime":0.2}],
		{"breakGroup":"wheel_RL"},
		["rh2l","rw1ll", {"precompressionRange":"$=$CamberRear*2.02+0.0066","beamPrecompressionTime":0.2}],
		{"breakGroup":""},
		{"optional":false},

		//--Control arm--
		//toe-link
		{"beamSpring":16001000,"beamDamp":1200},
		{"beamDeform":235100,"beamStrength":625000},
		["rh3l", "rx1l", {"precompressionRange":"$=$toe_R+0.001","beamPrecompressionTime":0.2, "dampCutoffHz":500}],
		["rh3r", "rx1r", {"precompressionRange":"$=$toe_R+0.001","beamPrecompressionTime":0.2, "dampCutoffHz":500}],
		//arb link
		{"beamSpring":1501000,"beamDamp":150},
		{"beamDeform":30000,"beamStrength":"FLT_MAX"},
		["rarb3r", "rx2r", {"precompressionRange":"$=$arb_point_R*0.58", "beamPrecompressionTime":0.2}],
		["rarb3l", "rx2l", {"precompressionRange":"$=$arb_point_R*0.58", "beamPrecompressionTime":0.2}],
		["rarb3r", "rh1r", {"precompressionRange":"$=0-$arb_point_R*0.58", "beamPrecompressionTime":0.2}],
		["rarb3l", "rh1l", {"precompressionRange":"$=0-$arb_point_R*0.58", "beamPrecompressionTime":0.2}],
		//zip tie
		{"beamSpring":2500,"beamDamp":25},
		{"beamDeform":1250,"beamStrength":1550},
		["rarmg2l", "rh2l", {"beamPrecompression":1.02,"beamPrecompressionTime":0.2}],
		["rarmg2r", "rh2r", {"beamPrecompression":1.02,"beamPrecompressionTime":0.2}],
		["rarmg2l", "rs2l", {"beamPrecompression":1.02,"beamPrecompressionTime":0.2}],
		["rarmg2r", "rs2r", {"beamPrecompression":1.02,"beamPrecompressionTime":0.2}],

		//--Springs--
		//main spring
		{"optional":true},
		{"beamSpring":"$=$components.springs.kR","beamDamp":25},
		{"beamDeform":155000,"beamStrength":305000},
		["rhe1r","rs1r", {
			"name":"spring_RR",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthR","beamPrecompressionTime":0.3}
		],
		["rhe1l","rs1l", {
			"name":"spring_RL",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthR","beamPrecompressionTime":0.3}
		],
		//helper spring
		{"beamSpring":8000,"beamDamp":10},
		["rhe1r", "rcl1r", {"precompressionRange":0.088,"beamPrecompressionTime":0.3}],
		["rhe1l", "rcl1l", {"precompressionRange":0.088,"beamPrecompressionTime":0.3}],
		//helper stopper
		{"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":100, "beamShortBound":100},
		{"beamSpring":1001000,"beamDamp":50},
		["rhe1r", "rcl1r", {"precompressionRange":-0.068,"beamPrecompressionTime":0.3}],
		["rhe1l", "rcl1l", {"precompressionRange":-0.068,"beamPrecompressionTime":0.3}],
		{"optional":false},

		//--Damper Hydraulics--
		//damper internal gas preload
		{"beamPrecompression":1, "beamType":"|PRESSURED"},
		{"beamSpring":"$=4.11*$dampGas_R","beamDamp":3.6}, //k=(1.4*A^2*P)/V, 100mm length, 44 diameter
		{"beamLimitSpring":0,"beamLimitDamp":0},
		["rh2r", "rs1r", {"pressurePSI":"$dampGas_R","surface":0.00025447,"volumeCoef":0}], //shaft rod diameter 18mm
		["rh2l", "rs1l", {"pressurePSI":"$dampGas_R","surface":0.00025447,"volumeCoef":0}],
		//main damper
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"beamDeform":225000,"beamStrength":"FLT_MAX"},
		["rs2r","rs1r", { //bottom out
			"longBoundRange":0.01,"shortBoundRange":0.270,"boundZone":0.01, //longBound when rubber rebound stop failed (highly unlikely), shortBound includes rubber bump stop
			"beamLimitSpring":801000,									  //total piston travel equals to longBound + shortBound
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,											//effective damping travel is less than piston travel since hard stops are there
			"dampCutoffHz":500}
		],
		["rs2l","rs1l", {
			"longBoundRange":0.01,"shortBoundRange":0.270,"boundZone":0.01,
			"beamLimitSpring":801000,
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,
			"dampCutoffHz":500}
		],
		["rs2r","rs1r", { //hard bump
			"longBoundRange":1,"shortBoundRange":0.255,"boundZone":0.018, //15mm hard stop co working with HBS
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["rs2l","rs1l", {
			"longBoundRange":1,"shortBoundRange":0.255,"boundZone":0.018,
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["rs2r","rs1r", { //hard (elastic) rebound
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005, //10mm hard stop for protection
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		["rs2l","rs1l", {
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005,
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_RR"},
		{"beamDeform":125000,"beamStrength":175000},
		["rh2r","rs1r", { //RR damper
			"name":"damper_RR",
			//LS Control
			"beamDamp":"$dampRate_bump_R",
			"beamDampRebound":"$=$dampRate_rebound_R",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_R_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_R",
			"dampCutoffHz":500}
		],
		["rh2r","rs1r", { //1-phase valve close HBS co-working with hard stop
			"name":"bumpstop_RR",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.275-$dampPos_hystop_R","boundZone":"$=$dampPos_hystop_R",
			"beamLimitSpring":150,
			"beamLimitDamp":"$dampRate_stop_R",
			"beamLimitDampRebound":50
			"dampCutoffHz":250}
		],
		["rh2r","rs1r", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.275-$dampPos_hystop_R","boundZone":0.01,
			"beamLimitSpring":18500}
		],
		["rh2r","rs1r", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.018,
			//leave rebound stop space
			"precompressionRange":-0.018,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":50,
			"beamLimitDampRebound":"$dampRateRebound_stop_R",
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_RL"},
		{"beamDeform":125000,"beamStrength":175000},
		["rh2l","rs1l", { //RL damper
			"name":"damper_RL",
			//LS Control
			"beamDamp":"$dampRate_bump_R",
			"beamDampRebound":"$=$dampRate_rebound_R",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_R_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_R",
			"dampCutoffHz":500}
		],
		["rh2l","rs1l", { //1-phase valve close HBS co-working with hard stop
			"name":"bumpstop_RL",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.275-$dampPos_hystop_R","boundZone":"$=$dampPos_hystop_R",
			"beamLimitSpring":150,
			"beamLimitDamp":"$dampRate_stop_R",
			"beamLimitDampRebound":50
			"dampCutoffHz":250}
		],
		["rh2l","rs1l", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.275-$dampPos_hystop_R","boundZone":0.01,
			"beamLimitSpring":18500}
		],
		["rh2l","rs1l", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.018,
			//leave rebound stop space
			"precompressionRange":-0.018,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":50,
			"beamLimitDampRebound":"$dampRateRebound_stop_R",
			"dampCutoffHz":250}
		],
		{"breakGroup":""},

		//--Detection Mass--
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		//LRS
		{"breakGroup":"damper_RR"}
		["rmassr", "rs2r", {"name":"LRS_RR"}],
		["rmassr", "rh2r", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"breakGroup":"damper_RL"}
		["rmassl", "rs2l", {"name":"LRS_RL"}],
		["rmassl", "rh2l", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
	"pressureWheels": [
		["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
		//cancel out brake properties before future wheel parts are loaded
		{"brakeTorque":0},
		{"parkingTorque":0},
		{"enableBrakeThermals":false},
		{"brakeDiameter":false},
		{"brakeMass":false},
		{"brakeType":false},
		{"rotorMaterial":false},
		{"brakeVentingCoef":false},
	],
	 "components": {
		"brakes":{
			"ductMeshR":"Astral_duct_R"
			"ductMeshRG":"Astral_chassis_R"
		},
	}
},
"Astral_group_R_rx3": {
	"information":{
		"authors":"Un1corn",
		"name":"CTM MRX60",
		"value":3200,
	},
	"slotType" : "Astral_group_R",
	"slots2" : [
		["name"                      , "allowTypes"                  , "denyTypes", "default"                      , "description"],
		["Astral_hubs_R"             , ["wheel_R_5"]                 , []         , "Astral_hubs_R_rx"             , "Rear Wheels", {"nodeOffset":{"x":"$=0.3325+$TrackRear", "y":1.26, "z":0.185}}],
		["Astral_brake_R"            , ["Astral_brake_R"]            , []         , "Astral_brake_R_355"           , "Brake Disc" , {"nodeOffset":{"x":0, "y":1.26, "z":0.185}}],
		["Astral_brake_duct_R_rally2", ["Astral_brake_duct_R_rally2"], []         , "Astral_brake_duct_R_no_rally2", "Rear Duct"  , {"coreSlot":true}],
		["Astral_spring_R_rx3"       , ["Astral_spring_R_rx3"]       , []         , "Astral_spring_R_rx3_33"       , "Spring"],
		["Astral_shim_R_rx"          , ["Astral_shim_R_rx"]          , []         , "Astral_shim_R_rx_l"           , "Shim Stacks", {"coreSlot":true}]
	],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_arm_r9", ["Astral_arm_R"]],
		["Astral_rod_r9", ["Astral_arm_R"]],
		["Astral_arb_r9", ["Astral_arb2_R"]],
		["Astral_hub_r9", ["Astral_hub_RR","Astral_hub_RL"]],
		["Astral_damper_platform_r9", ["Astral_damper_R"]],
		["Astral_damper_piston_r9", ["Astral_piston_R"]],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampPos_hystop_R", "range", "mm", "Suspension - Dampers and Springs", 0.025, 0.021, 0.030, "HBS Travel", "Hard bump stop startig point in total travel", {"stepDis":1,"minDis":21,"maxDis":30,"subCategory":"Rear Damper Internal"}],
		["$dampGas_R", "range", "PSI", "Suspension - Dampers and Springs", 225, 150, 250, "Gas Internal Pressure", "The pressure of nitrogen gas inside damper", {"stepDis":25,"subCategory":"Rear Damper Internal"}],
		["$RideHeightOffsetRear", "range", "mm", "Suspension - Dampers and Springs", 0.027, 0.012, 0.045, "Spring Collar Offset", "Changes the platform height", {"stepDis":3,"minDis":-15,"maxDis":18,"subCategory":"Rear Damper - 3-Way"}], //rx1 node from the ground about 172mm
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Hub--
		//hub mounting points for control arm
		{"nodeWeight":8.5},
		["rh1r", -0.749, 1.341, 0.01, {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh1l",  0.749, 1.341, 0.01, {"group":["Astral_hub_RL","Astral_arm_R"]}],
		//strut attach
		{"nodeWeight":4.75},
		["rh2r", -0.5632, 1.3474, 0.33, {"group":["Astral_hub_RR","Astral_damper_R"]}],
		["rh2l",  0.5632, 1.3474, 0.33, {"group":["Astral_hub_RL","Astral_damper_R"]}],
		//toe link
		{"nodeWeight":3.75},
		["rh3r", -0.745, 1.151, "$=0.0254+$Bumpsteer_R", {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh3l",  0.745, 1.151, "$=0.0254+$Bumpsteer_R", {"group":["Astral_hub_RR","Astral_arm_R"]}],
		//brake calipers
		{"nodeWeight":"$=4.0*$brakeThickness_R"},
		["rh5r", -0.805, 1.114, 0.188, {"group":["Astral_hub_RR","Astral_duct_RR"]}],
		["rh5l",  0.805, 1.114, 0.188, {"group":["Astral_hub_RL","Astral_duct_RL"]}],

		//--Arm--
		//arb end link
		{"nodeWeight":1.25},
		{"group":["Astral_arb2_R"]},
		["rarb3r", -0.462, 1.3584, 0.0634],
		["rarb3l",  0.462, 1.3584, 0.0634],

		//--Strut--
		//damper top point
		{"group":["Astral_piston_R","Astral_spring_R","Astral_chassis_R"]},
		{"nodeWeight":5.25},
		["rs1r", -0.55, 1.337, 0.797],
		["rs1l",  0.55, 1.337, 0.797],
		//lower spring collar
		{"group":["Astral_helper_R"]},
		{"nodeWeight":0.4},
		{"selfCollision":false},
		["rcl1r", -0.5617, 1.3463, 0.381],
		["rcl1l",  0.5617, 1.3463, 0.381],
		//piston outer shell to mount LRS
		{"group":["Astral_piston_R"]},
		{"nodeWeight":0.1},
		["rps1r", -0.557, 1.3426, 0.547],
		["rps1l",  0.557, 1.3426, 0.547],
		//mass
		{"group":[""]},
		{"nodeWeight":0.1},
		["rmassr", -0.5643, 1.348, 0.29],
		["rmassl",  0.5643, 1.348, 0.29],
		//damper end
		{"nodeWeight":4.05},
		{"group":["Astral_damper_R"]},
		["rs2r", -0.5677, 1.351, 0.17],
		["rs2l",  0.5677, 1.351, 0.17],
		//damper flexbodu stuff
		{"collision":false},
		{"nodeWeight":0.1},
		{"group":["Astral_damper_R"]},
		["rs3r", -0.456, 1.3398, 0.322, {"selfCollision":false}],
		["rs3l",  0.456, 1.3398, 0.322, {"selfCollision":false}],
		{"group":[""]},
		{"collision":true},
		{"selfCollision":true},
	],
	"rails": {
		//strut shaft rail
		"strut_RR":{"links:":["rs2r", "rs1r"], "broken:":[], "looped":false, "capped":true},
		"strut_RL":{"links:":["rs2l", "rs1l"], "broken:":[], "looped":false, "capped":true},
		//strut body shell
		"strut2_RR":{"links:":["rs2r", "rh2r"], "broken:":[], "looped":false, "capped":true},
		"strut2_RL":{"links:":["rs2l", "rh2l"], "broken:":[], "looped":false, "capped":true},
		//arb mounting rail
		"arb_RR":{"links:":["rh1r", "rx2r"], "broken:":[], "looped":false, "capped":true},
		"arb_RL":{"links:":["rh1l", "rx2l"], "broken:":[], "looped":false, "capped":true},
	},
	"slidenodes": [
		["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
		//attach strut body to strut shaft rail
	    ["rh2r", "strut_RR", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["rh2l", "strut_RL", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["rcl1r", "strut_RR", true, true, 0.0, 2001000, "FLT_MAX", "FLT_MAX"],
		["rcl1l", "strut_RL", true, true, 0.0, 2001000, "FLT_MAX", "FLT_MAX"],
		//spring collar
		["rhe1r", "strut_RR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		["rhe1l", "strut_RL", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		//piston
		["rps1r", "strut_RR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["rps1l", "strut_RL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//mass
		["rmassr", "strut2_RR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["rmassl", "strut2_RL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//arb mounting point
		["rarb3r", "arb_RR", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"],
		["rarb3l", "arb_RL", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"]
	],
	"beams": [
		["id1:", "id2:"]
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Hub and Wheel--
		//camber
		{"beamSpring":3501000,"beamDamp":180},
		{"breakGroup":"wheel_RR"},
		["rh2r","rw1rr", {"precompressionRange":"$=$CamberRear*2.38-0.0018","beamPrecompressionTime":0.2}],
		{"breakGroup":"wheel_RL"},
		["rh2l","rw1ll", {"precompressionRange":"$=$CamberRear*2.38-0.0032","beamPrecompressionTime":0.2}],
		{"breakGroup":""},
		{"optional":false},

		//--Control arm--
		//toe-link
		{"beamSpring":16001000,"beamDamp":600},
		{"beamDeform":235100,"beamStrength":625000},
		["rh3l", "rx1l", {"precompressionRange":"$=$toe_R-0.0002","beamPrecompressionTime":0.2, "dampCutoffHz":500}],
		["rh3r", "rx1r", {"precompressionRange":"$=$toe_R-0.0000","beamPrecompressionTime":0.2, "dampCutoffHz":500}],
		//arb link
		{"beamSpring":1501000,"beamDamp":150},
		{"beamDeform":30000,"beamStrength":"FLT_MAX"},
		["rarb3r", "rx2r", {"precompressionRange":"$=$arb_point_R*0.33", "beamPrecompressionTime":0.2}],
		["rarb3l", "rx2l", {"precompressionRange":"$=$arb_point_R*0.33", "beamPrecompressionTime":0.2}],
		["rarb3r", "rh1r", {"precompressionRange":"$=0-$arb_point_R*0.33", "beamPrecompressionTime":0.2}],
		["rarb3l", "rh1l", {"precompressionRange":"$=0-$arb_point_R*0.33", "beamPrecompressionTime":0.2}],

		//--Springs--
		//main spring
		{"optional":true},
		{"beamSpring":"$=$components.springs.kR","beamDamp":25},
		{"beamDeform":155000,"beamStrength":305000},
		["rhe1r","rs1r", {
			"name":"spring_RR",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthR","beamPrecompressionTime":0.3}
		],
		["rhe1l","rs1l", {
			"name":"spring_RL",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthR","beamPrecompressionTime":0.3}
		],
		//helper spring
		{"beamSpring":5000,"beamDamp":10},
		["rhe1r", "rcl1r", {"precompressionRange":0.046,"beamPrecompressionTime":0.3}],
		["rhe1l", "rcl1l", {"precompressionRange":0.046,"beamPrecompressionTime":0.3}],
		//helper stopper
		{"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":100, "beamShortBound":100},
		{"beamSpring":1001000,"beamDamp":50},
		["rhe1r", "rcl1r", {"precompressionRange":-0.110,"beamPrecompressionTime":0.3}],
		["rhe1l", "rcl1l", {"precompressionRange":-0.110,"beamPrecompressionTime":0.3}],
		{"optional":false},

		//--Damper Hydraulics--
		//damper internal gas preload
		{"beamPrecompression":1, "beamType":"|PRESSURED"},
		{"beamSpring":"$=4.11*$dampGas_R","beamDamp":3.6}, //k=(1.4*A^2*P)/V, 100mm length, 44 diameter
		{"beamLimitSpring":0,"beamLimitDamp":0},
		["rh2r", "rs1r", {"pressurePSI":"$dampGas_R","surface":0.00025447,"volumeCoef":0}], //shaft rod diameter 18mm
		["rh2l", "rs1l", {"pressurePSI":"$dampGas_R","surface":0.00025447,"volumeCoef":0}],
		//main damper
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"beamDeform":225000,"beamStrength":"FLT_MAX"},
		["rs2r","rs1r", { //bottom out
			"longBoundRange":0.01,"shortBoundRange":0.180,"boundZone":0.01, //longBound when rubber rebound stop failed (highly unlikely), shortBound includes rubber bump stop
			"beamLimitSpring":801000,									  //total piston travel equals to longBound + shortBound
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,											//effective damping travel is less than piston travel since hard stops are there
			"dampCutoffHz":500}
		],
		["rs2l","rs1l", {
			"longBoundRange":0.01,"shortBoundRange":0.180,"boundZone":0.01,
			"beamLimitSpring":801000,
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,
			"dampCutoffHz":500}
		],
		["rs2r","rs1r", { //hard bump
			"longBoundRange":1,"shortBoundRange":0.170,"boundZone":0.01, //10mm hard stop for protection
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["rs2l","rs1l", {
			"longBoundRange":1,"shortBoundRange":0.170,"boundZone":0.01,
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["rs2r","rs1r", { //hard (elastic) rebound
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005, //10mm hard stop for protection
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		["rs2l","rs1l", {
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005,
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_RR"},
		{"beamDeform":65000,"beamStrength":125000},
		["rh2r","rs1r", { //RR damper
			"name":"damper_RR",
			//LS Control
			"beamDamp":"$dampRate_bump_R",
			"beamDampRebound":"$=$dampRate_rebound_R",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_R_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_R",
			"dampCutoffHz":500}
		],
		["rh2r","rs1r", { //1-phase valve close HBS with internal compression spring
			"name":"bumpstop_RR",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.180-$dampPos_hystop_R","boundZone":"$=$dampPos_hystop_R",
			"beamLimitSpring":150,
			"beamLimitDamp":"$=8000-($dampRate_bump_R*0.06)",
			"beamLimitDampRebound":50
			"dampCutoffHz":250}
		],
		["rh2r","rs1r", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.180-$dampPos_hystop_R","boundZone":0.01,
			"beamLimitSpring":11000}
		],
		["rh2r","rs1r", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.012,
			//leave rebound stop space
			"precompressionRange":-0.012,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":150,
			"beamLimitDamp":50,
			"beamLimitDampRebound":4250
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_RL"},
		{"beamDeform":65000,"beamStrength":125000},
		["rh2l","rs1l", { //RL damper
			"name":"damper_RL",
			//LS Control
			"beamDamp":"$dampRate_bump_R",
			"beamDampRebound":"$=$dampRate_rebound_R",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_R_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_R",
			"dampCutoffHz":500}
		],
		["rh2l","rs1l", { //1-phase valve close HBS with internal compression spring
			"name":"bumpstop_RL",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.180-$dampPos_hystop_R","boundZone":"$=$dampPos_hystop_R",
			"beamLimitSpring":50,
			"beamLimitDamp":"$=8000-($dampRate_bump_R*0.06)",
			"beamLimitDampRebound":50
			"dampCutoffHz":250}
		],
		["rh2l","rs1l", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.180-$dampPos_hystop_R","boundZone":0.01,
			"beamLimitSpring":11000}
		],
		["rh2l","rs1l", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.012,
			//leave rebound stop space
			"precompressionRange":-0.012,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":50,
			"beamLimitDampRebound":4250
			"dampCutoffHz":250}
		],
		{"breakGroup":""},

		//--Detection Mass--
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		//LRS
		{"breakGroup":"damper_RR"}
		["rmassr", "rs2r", {"name":"LRS_RR"}],
		["rmassr", "rh2r", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"breakGroup":"damper_RL"}
		["rmassl", "rs2l", {"name":"LRS_RL"}],
		["rmassl", "rh2l", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
	"pressureWheels": [
		["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
		//cancel out brake properties before future wheel parts are loaded
		{"brakeTorque":0},
		{"parkingTorque":0},
		{"enableBrakeThermals":false},
		{"brakeDiameter":false},
		{"brakeMass":false},
		{"brakeType":false},
		{"rotorMaterial":false},
		{"brakeVentingCoef":false},
	],
	"components": {
		"brakes":{
			"ductMeshR":"Astral_duct_R"
			"ductMeshRG":"Astral_chassis_R"
		},
	}
},
"Astral_shim_R_rx_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_rx",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_bump_R", "range", "Clicks", "Suspension - Dampers and Springs", 3250, 2290, 4210, "LS Bump", "Low speed bump damping controls car dynamics and small bump absorption", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampRate_bump_R_fast", "range", "Clicks", "Suspension - Dampers and Springs", 4200, 2600, 5800, "HS Bump", "High speed bump damping controls jump and big bump absorption", {"stepDis":1,"minDis":-20,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampRate_rebound_R", "range", "Clicks", "Suspension - Dampers and Springs", 3250, 2290, 4210, "Rebound", "Rebound damping controls how fast the damper extends", {"stepDis":1,"minDis":-48,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$velocitySplit_R", "range", "m/s", "Suspension - Dampers and Springs", 0.48, 0.21, 0.75, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.09,"subCategory":"Rear Damper Internal"}],
		["$LRS_R", "range", "x", "Suspension - Dampers and Springs", 0.5, 0.25, 1, "LRS Open Factor", "The openness of rebound when LRS bypass valve is activated", {"stepDis":0.025,"subCategory":"Rear Damper Internal"}],
		["$LRSShim_R", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Rear Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"RearLRS"}],
	],
	"RearLRS": {
		"loads": [
			["name", "LRSName",  "LRSp",			   "LRSf"]
			["RR",   "LRS_RR",   "$=0.1218+$LRSShim_R", "$LRS_R"]
			["RL",   "LRS_RL",   "$=0.1218+$LRSShim_R", "$LRS_R"]
		],
		"dampers": [
			["name", "beamName"]
			["RR",   "damper_RR"]
			["RL",   "damper_RL"]
		],
		"damping":[
			["name", "beamDamp",		 "beamDampFast",		  "beamDampRebound",	 "beamDampReboundFast",		"beamDampVelocitySplit",															  "beamDampVelocitySplitRebound"]
			["RR",   "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.95", "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2290)/9600", 0.65						 ]
			["RL",   "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.95", "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2290)/9600", 0.65						 ]
		]
	},
},
"Astral_shim_R_rx3_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_rx",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_bump_R", "range", "Clicks", "Suspension - Dampers and Springs", 3050, 2090, 4010, "LS Bump", "Low speed bump damping controls car dynamics and small bump absorption", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$dampRate_bump_R_fast", "range", "Clicks", "Suspension - Dampers and Springs", 4200, 2600, 5800, "HS Bump", "High speed bump damping controls jump and big bump absorption", {"stepDis":1,"minDis":-20,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$dampRate_rebound_R", "range", "Clicks", "Suspension - Dampers and Springs", 3050, 2090, 4010, "Rebound", "Rebound damping controls how fast the damper extends", {"stepDis":1,"minDis":-48,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$velocitySplit_R", "range", "m/s", "Suspension - Dampers and Springs", 0.42, 0.15, 0.69, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.09,"subCategory":"Rear Damper Internal"}],
		["$LRSShim_R", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Rear Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"RearLRS"}],
	],
	"RearLRS": {
		"loads": [
			["name", "LRSName",  "LRSp",			   "LRSf"]
			["RR",   "LRS_RR",   "$=0.1218+$LRSShim_R", 0.499]
			["RL",   "LRS_RL",   "$=0.1218+$LRSShim_R", 0.499]
		],
		"dampers": [
			["name", "beamName"]
			["RR",   "damper_RR"]
			["RL",   "damper_RL"]
		],
		"damping":[
			["name", "beamDamp",		 "beamDampFast",		  "beamDampRebound",	 "beamDampReboundFast",		"beamDampVelocitySplit",															  "beamDampVelocitySplitRebound"]
			["RR",   "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.9",  "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2090)/9600", 0.65						 ]
			["RL",   "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.9",  "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2090)/9600", 0.65						 ]
		]
	},
},
}
