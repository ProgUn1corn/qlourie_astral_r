{
"Astral_wheels_F_wrc17_tarmac":{
	"information":{
		"authors":"Un1corn",
		"name":"235/40R18 Tarmac",
	},
	"slotType" : "Astral_wheels_F_wrc17",
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_tyre_f4", ["tire_FL", "wheel_FL"], [], {"pos":{"x": 0.465, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
		["Astral_tyre_f4", ["tire_FR", "wheel_FR"], [], {"pos":{"x":-0.465, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
		["Astral_wheel_f4", ["wheel_FL", "axf_L"], [], {"pos":{"x": 0.455, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
		["Astral_wheel_f4", ["wheel_FR", "axf_R"], [], {"pos":{"x":-0.455, "y":0, "z":0}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}]

	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Front Axle--
		{"nodeWeight":5.0},
		{"chemEnergy":200,"burnRate":0.5,"flashPoint":300,"smokePoint":200,"selfIgnition":0,"specHeat":1},
		["fw1r", -0.28, 0, 0, {"staticCollision":false, "group":"axf_R"}],
		["fw1rr",-0.59, 0, 0, {"staticCollision":false, "group":"axf_R"}],
		["fw1l",  0.28, 0, 0, {"staticCollision":false, "group":"axf_L"}],
		["fw1ll", 0.59, 0, 0, {"staticCollision":false, "group":"axf_L"}],
		{"chemEnergy":false,"burnRate":false,"flashPoint":false,"smokePoint":false,"selfIgnition":false,"specHeat":false}
	],
	"beams": [
		["id1:", "id2:"],
		{"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
		{"breakGroup":""},
		{"beamDeform":78500,"beamStrength":434000},
		{"beamSpring":1501000,"beamDamp":25},
		["fw1ll", "fw1l"],
		["fw1rr", "fw1r"],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$frontPSI", "range", "PSI", "Tyres", 29, 5, 45, "Front Tyre Pressure", "Initial Tyre Pressure", {"stepDis":0.5}]
	],
	"pressureWheels": [
		["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
		{"disableMeshBreaking":false,"disableHubMeshBreaking":false},
		{"hasTire":true},
		{"enableTireReinfBeams":false},
		{"enableTireLbeams":true},
		{"enableTireSideReinfBeams":false},
		{"enableTreadReinfBeams":true},
		{"enableTirePeripheryReinfBeams":true},
		{"triangleCollision":false},

		//general settings
		{"radius":0.325},
		{"hubRadius":0.23},
		{"wheelOffset":-0.03},
		{"hubWidth":0.220},
		{"tireWidth":0.205},
		{"numRays":16},

		//hub options
		{"hubTreadBeamSpring":990900, "hubTreadBeamDamp":9},
		{"hubPeripheryBeamSpring":995000, "hubPeripheryBeamDamp":9},
		{"hubSideBeamSpring":1401000, "hubSideBeamDamp":9},
		{"hubNodeWeight":0.451}
		{"hubNodeMaterial":"|NM_METAL"},
		{"hubFrictionCoef":0.5},

		//tire options
		{"wheelSideBeamSpring":"$=$frontPSI*704","wheelSideBeamDamp":100},
		{"wheelSideBeamSpringExpansion":412000,"wheelSideBeamDampExpansion":60},
		{"wheelSideTransitionZone":0.08,"wheelSideBeamPrecompression":0.98},

		{"wheelReinfBeamSpring":43600,"wheelReinfBeamDamp":200},
		{"wheelReinfBeamDampCutoffHz":500,"wheelReinfBeamPrecompression":0.98},

		{"wheelTreadBeamSpring":126000,"wheelTreadBeamDamp":75},
		{"wheelTreadBeamDampCutoffHz":500,"wheelTreadBeamPrecompression":0.98},

		{"wheelTreadReinfBeamSpring":151000,"wheelTreadReinfBeamDamp":60},
		{"wheelTreadReinfBeamDampCutoffHz":500,"wheelTreadReinfBeamPrecompression":0.98},

		{"wheelPeripheryBeamSpring":86000,"wheelPeripheryBeamDamp":75},
		{"wheelPeripheryBeamDampCutoffHz":500,"wheelPeripheryBeamPrecompression":0.98},

		{"wheelPeripheryReinfBeamSpring":125000,"wheelPeripheryReinfBeamDamp":75},
		{"wheelPeripheryReinfBeamDampCutoffHz":500,"wheelPeripheryReinfBeamPrecompression":0.98},

		//general tire values
		{"nodeWeight":0.159},
		{"nodeMaterial":"|NM_RUBBER"},
		{"pressurePSI":"$frontPSI"},
		{"dragCoef":5},

		//groundmodel friction multipliers
		{"frictionCoef":1.0},
		{"slidingFrictionCoef":1.01},
		{"treadCoef":0.10},
		{"stribeckExponent":1.58},
		{"stribeckVelocity":1.08},

		//advanced friction values
		{"noLoadCoef":2.00},
		{"loadSensitivitySlope":0.000227},
		{"fullLoadCoef":0.70},
		{"softnessCoef":0.99},

		//deform values
		{"hubBeamDeform":115000, "hubBeamStrength":125000},
		{"wheelSideBeamDeform":21000,"wheelSideBeamStrength":21500},
		{"wheelTreadBeamDeform":21000,"wheelTreadBeamStrength":21000},
		{"wheelPeripheryBeamDeform":45000,"wheelPeripheryBeamStrength":49000},

		//cancel out brake properties before future wheel parts are loaded
		{"brakeTorque":0},
		{"parkingTorque":0},
		{"enableBrakeThermals":false},
		{"brakeDiameter":false},
		{"brakeMass":false},
		{"brakeType":false},
		{"rotorMaterial":false},
		{"brakeVentingCoef":false}
	]
},
