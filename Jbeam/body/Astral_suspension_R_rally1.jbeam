	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_stop_R", "range", "Clicks", "Suspension - Dampers and Springs", 10000, 8000, 12000, "HBS Damping", "HBS damping stiffness", {"stepDis":1,"minDis":-8,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampRateRebound_stop_R", "range", "Clicks", "Suspension - Dampers and Springs", 4000, 2000, 6000, "HRS Damping", "HRS damping stiffness", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
		["$dampPos_hystop_R", "range", "mm", "Suspension - Dampers and Springs", 0.039, 0.033, 0.045, "HBS Travel", "Adjust hydraulic bump stop's travel length", {"stepDis":1,"minDis":33,"maxDis":45,"subCategory":"Rear Damper Internal"}],
		["$dampGas_R", "range", "PSI", "Suspension - Dampers and Springs", 200, 150, 250, "Gas Internal Pressure", "The pressure of nitrogen gas inside damper", {"stepDis":25,"subCategory":"Rear Damper Internal"}],
		["$RideHeightOffsetRear", "range", "mm", "Suspension - Dampers and Springs", 0.051, 0.033, 0.066, "Spring Collar Offset", "Changes the platform height", {"stepDis":3,"minDis":-18,"maxDis":15,"subCategory":"Rear Damper - 3+2-Way"}], //rg1 node from the ground about 185mm
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Hub--
		//hub mounting points for control arm
		{"nodeWeight":8.5},
		["rh1r", -0.749, 1.341, -0.09, {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh1l",  0.749, 1.341, -0.09, {"group":["Astral_hub_RL","Astral_arm_R"]}],
		//strut attach
		{"nodeWeight":4.75},
		["rh2r", -0.5708, 1.3512, 0.18, {"group":["Astral_hub_RR","Astral_damper_R"]}],
		["rh2l",  0.5708, 1.3512, 0.18, {"group":["Astral_hub_RL","Astral_damper_R"]}],
		//toe link
		["rh3r", -0.745, 1.151, "$=-0.0758+$Bumpsteer_R", {"group":["Astral_hub_RR","Astral_arm_R"]}],
		["rh3l",  0.745, 1.151, "$=-0.0758+$Bumpsteer_R", {"group":["Astral_hub_RL","Astral_arm_R"]}],
		//brake caliper
		{"nodeWeight":"$=4.0*$brakeThickness_R"},
		["rh5r", -0.788, 1.101, 0.074, {"group":["Astral_hub_RR","Astral_duct_R"]}],
		["rh5l",  0.788, 1.101, 0.074, {"group":["Astral_hub_RL","Astral_duct_R"]}],

		//--Arm--
		//arb end link
		{"nodeWeight":1.25},
		{"group":["Astral_arb2_R"]},
		["rarb3r", -0.438, 1.3599, 0.0268],
		["rarb3l",  0.438, 1.3599, 0.0268],

		//--Strut--
		//damper top point
		{"group":["Astral_piston_R","Astral_spring_R","Astral_chassis_R"]},
		{"nodeWeight":10.5},
		["rs1r", -0.55, 1.337, 0.797],
		["rs1l",  0.55, 1.337, 0.797],
		//lower spring collar
		{"group":["Astral_helper_R"]},
		{"nodeWeight":0.4},
		{"selfCollision":false},
		["rcl1r", -0.5692, 1.35, 0.227],
		["rcl1l",  0.5692, 1.35, 0.227],
		//piston outer shell to mount LRS
		{"group":["Astral_piston_R"]},
		{"nodeWeight":0.1},
		["rps1r", -0.5615, 1.3449, 0.455],
		["rps1l",  0.5615, 1.3449, 0.455],
		//mass
		{"group":[""]},
		{"nodeWeight":0.1},
		["rmassr", -0.5723, 1.3522, 0.135],
		["rmassl",  0.5723, 1.3522, 0.135],
		//["rmass2r", -0.5542, 1.3399, 0.672],
		//["rmass2l",  0.5542, 1.3399, 0.672],
		//damper end
