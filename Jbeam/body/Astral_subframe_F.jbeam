"Astral_subframe_F": {
	"information":{
		"authors":"Un1corn",
		"name":"Front Subframe",
		"value":1000,
	},
	"slotType" : "Astral_subframe_F",
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_subframe_F", ["Astral_sub_F"]],
		["Astral_subframe_mount_F", ["Astral_sub_F"]],
	 ],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$CamberFront", "range", "mm", "Suspension - Subframes", 0, -0.002, 0.002, "Camber Spacer", "Adjust camber offset", {"stepDis":0.4,"subCategory":"Front Alignment","minDis":-2,"maxDis":2}],
		["$CasterFront", "range", "mm", "Suspension - Subframes", 0, -0.007, 0.007, "Caster Arm Length", "Adjust caster offset", {"stepDis":0.7,"subCategory":"Front Alignment","minDis":-7,"maxDis":7}],
		["$TrackFront", "range", "mm", "Suspension - Subframes", 0.0, -0.05, 0.05, "Track Width", "Adjust track width", {"stepDis":1,"minDis":-50,"maxDis":50,"subCategory":"Front Alignment"}],
		["$shimRack_F", "range", "mm", "Suspension - Subframes", 0, 0, 0.004, "Steering Rack Spacer", "Compensate for bumpsteer", {"stepDis":2,"minDis":0,"maxDis":4,"subCategory":"Front Alignment"}],
		["$arb_point_F", "range", "P", "Suspension - Subframes", 0, -0.1, 0, "ARB Mounting Point", "The point where ARB end link mounts", {"stepDis":1,"minDis":1,"maxDis":3,"subCategory":"Front Anti-roll"}],
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Subframe--
		//cross member
		{"nodeWeight":6.5},
		{"group":["Astral_arm_F","Astral_sub_F"]},
		["fx1r", -0.251, -1.295, 0.100],
		["fx1l",  0.251, -1.295, 0.100],
		["fx2r", -0.272, -0.975, 0.105],
		["fx2l",  0.272, -0.975, 0.105],
		//mounting points
		{"nodeWeight":4.5},
		{"group":["Astral_sub_F"]},
		["fx3r", -0.298, -0.848, 0.158, {"selfCollision":false}],
		["fx3l",  0.298, -0.848, 0.158, {"selfCollision":false}],
		{"nodeWeight":4.0},
		{"group":["Astral_sub_F","Astral_rod_F"]},
		["fx4r", -0.393, -1.168, 0.294],
		["fx4l",  0.393, -1.168, 0.294],
		//steering box
		{"nodeWeight":5.5},
		{"group":["Astral_sub_F", "Astral_str_F"]},
		["st1r", -0.130, -1.094, "$=0.130+$shimRack_F"],
		["st1l",  0.130, -1.094, "$=0.130+$shimRack_F"],
		//rigidifier
		{"collision":false},
		{"nodeWeight":3.0},
		{"group":[""]},
		["fx1", 0, -1.025, 0.295, {"selfCollision":false}],
		{"collision":true},
		{"selfCollision":true},
	],
	"beams": [
		["id1:", "id2:"],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Subframe--
		//cross member
		{"beamSpring":8501000,"beamDamp":180},
		{"beamDeform":65000,"beamStrength":"FLT_MAX"},
		["fx1r", "fx2r"],
		["fx2r", "fx2l"],
		["fx2l", "fx1l"],
		["fx1l", "fx1r"],
		//mounting
		{"beamSpring":3001000,"beamDamp":150},
		["fx2r", "fx3r"],
		["fx3r", "fx3l"],
		["fx3l", "fx2l"],
		["fx1r", "fx4r"],
		["fx2r", "fx4r"],
		["fx3r", "fx4r"],
		["fx1l", "fx4l"],
		["fx2l", "fx4l"],
		["fx3l", "fx4l"],
		//crossing
		{"beamSpring":8501000,"beamDamp":180},
		{"beamDeform":35000},
		["fx1r", "fx2l"],
		["fx1l", "fx2r"],
		{"beamSpring":3001000,"beamDamp":150},
		["fx2r", "fx3l"],
		["fx2l", "fx3r"],
		["fx1r", "fx4l"],
		["fx1l", "fx4r"],
		["fx2r", "fx4l"],
		["fx2l", "fx4r"],
		//rigid
		{"beamDeform":15000},
		["fx1r", "fx3r"],
		["fx1r", "fx3l"],
		["fx1l", "fx3l"],
		["fx1l", "fx3r"],
		//["fx3l", "fx4r"],
		//["fx3r", "fx4l"],
		//rigidifier
		{"beamSpring":3001000,"beamDamp":150},
		{"beamDeform":15000},
		["fx1", "fx1r"],
		["fx1", "fx2r"],
		["fx1", "fx3r"],
		["fx1", "fx4r"],
		["fx1", "fx1l"],
		["fx1", "fx2l"],
		["fx1", "fx3l"],
		["fx1", "fx4l"],
		//front mounting
		{"beamSpring":3001000,"beamDamp":150},
		{"beamDeform":25000,"beamStrength":180000},
		{"breakGroup":"subframe_FR"},
		["fx4r", "br1r"],
		["fx4r", "chs3r"],
		["fx4r", "chs4r"],
		["fx4r", "chsf"],
		["fx4r", "a53"],
