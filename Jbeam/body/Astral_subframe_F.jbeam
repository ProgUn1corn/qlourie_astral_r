		["fx2l", "br1l"],
		["fx2l", "a22"],
		["fx2l", "a54"],
		["fx2l", "a13"],
		{"breakGroup":""},

		//--Steering Rack--
		//steering box
		{"beamSpring":7501000,"beamDamp":200},
		{"beamDeform":65000,"beamStrength":"FLT_MAX"},
		["st1r","st1l"],
		//mounting to subframe
		{"beamSpring":5501000,"beamDamp":200},
		{"beamDeform":50000,"beamStrength":"FLT_MAX"},
		["st1r", "fx1r"],
		["st1r", "fx2r"],
