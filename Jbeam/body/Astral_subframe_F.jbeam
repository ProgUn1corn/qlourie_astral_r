		{"beamSpring":1001000,"beamDamp":50},
		["fcl1r", "fh2r", {"precompressionRange":"$=$RideHeightOffsetFront","beamPrecompressionTime":1}],
		["fcl1l", "fh2l", {"precompressionRange":"$=$RideHeightOffsetFront","beamPrecompressionTime":1}],
		//damper structure rail damping (ball joint)
		{"beamSpring":0,"beamDamp":150},
