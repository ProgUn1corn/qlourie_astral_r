	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_group_F", ["Astral_group_F"], [], "Astral_group_F_wrc17_tarmac", "Front Damper Group"],
		["Astral_swaybar_F", ["Astral_swaybar_F"], [], "Astral_swaybar_F_m", "Anti-Roll Bar"],
