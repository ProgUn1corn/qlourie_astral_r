		["fh1l","fw1ll"],
		["fh3l","fw1ll", {"beamSpring":12001000,"beamDamp":20}],
		["fh5l","fw1ll"],
		["fs2l","fw1ll"],
		{"breakGroup":""},
		{"optional":false},

		//--Control Arm and Structure Damping--
		//ARB link
		{"beamSpring":0,"beamDamp":500},
		["farb3r","fx1r"],
		["farb3l","fx1l"],
		//control arm
		{"beamSpring":16001000,"beamDamp":2400},
		{"beamDeform":125100,"beamStrength":600000},
		{"dampCutoffHz":500},
		["fx1r", "fh1r"],
		["fx1l", "fh1l"],
		{"beamSpring":22001000,"beamDamp":2400},
		["fx2r", "fh1r"],
		["fx2l", "fh1l"],
