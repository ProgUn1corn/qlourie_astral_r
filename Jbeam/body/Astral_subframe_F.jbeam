		["fcl1r","a54"],
		["fcl1l","a19"],
		["fcl1l","a53"],
		["fps1r","chs4l"],
		["fps1r","a12"],
		["fps1l","chs4r"],
		["fps1l","a15"],
		{"optional":true},
