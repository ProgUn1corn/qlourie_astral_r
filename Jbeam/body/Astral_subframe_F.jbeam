		["fx3r", "a21"],
		["fx3r", "a53"],
		["fx3r", "a54"],
		["fx3r", "a84"],
		["fx3r", "a85"],
		["fx3r", "chs3r"],
		//*
		{"breakGroup":"subframe_FRL"},
		["fx3l", "a23"],
		["fx3l", "a22"],
		["fx3l", "a54"],
		["fx3l", "a53"],
		["fx3l", "a87"],
		["fx3l", "a86"],
		["fx3l", "chs3l"],
		//lower mounting
		{"beamDeform":25000,"beamStrength":180000},
		{"breakGroup":"subframe_FR"},
		["fx1r", "a16"],
		["fx1r", "br1r"],
		["fx1r", "br1l"],
		["fx1r", "a22"],
		["fx2r", "br1r"],
		["fx2r", "a21"],
		["fx2r", "a53"],
		["fx2r", "a14"],
		//*
		{"breakGroup":"subframe_FL"},
