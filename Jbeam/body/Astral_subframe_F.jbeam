"Astral_steering_h": {
	"information":{
		"authors":"Un1corn",
		"name":"Quick Ratio Steering",
		"value":1200
	},
	"slotType" : "Astral_steering",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_power_steering", ["Astral_power_steering"], [], "Astral_power_steering", "Power Steering"]
	],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_steering_F", ["Astral_sub_F"]],
	 ],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$toe_F", "range", "mm", "Suspension - Subframes", 0, -0.0024, 0.0024, "Steering Rod Length", "Adjusts the wheel toe angle", {"stepDis":0.1,"subCategory":"Front Alignment","minDis":-2.4,"maxDis":2.4}],
		["$ffbTune", "range", "", "Steering", 1, 0, 2, "Setup-Specific Force Feedback Multiplier", "Fine tune the force feedback strength for this vehicle", {"minDis":0,"maxDis":200, "subCategory":"Power Steering"}],
		["$steer_center_F", "range", "", "Steering", 0, -0.001, 0.001, "Steering L/R Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Steering Angle"}]
		["$steer_lock", "range", "Degrees", "Steering", 240, 180, 360, "Steering Wheel Lock", "Adjust the steering gear on the steering rack (steering ratio)", {"subCategory":"Steering Angle", "minDis":360,"maxDis":720, "stepDis":60}]
	],
	"beams": [
		["id1:","id2:"],
		{"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Steering Rod--
		{"beamSpring":12001000,"beamDamp":400,"beamDeform":125000,"beamStrength":1525000},
		{"dampCutoffHz":1000}
		["st2r","st2l"],
		//tie rode damper
		{"beamSpring":0,"beamDamp":50},
		["st2r","fx1r"],
		["st2r","fx2r"],
		["st2r","a22"],
		["st2r","fx4r"],
		["st2l","fx1l"],
		["st2l","fx2l"],
		["st2l","a21"],
		["st2l","fx4l"],
		{"dampCutoffHz":""},
		//steering damper
		{"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
		{"beamDeform":25000,"beamStrength":125000},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"beamSpring":0,"beamDamp":80},
		["fh3r","fx1r", {"beamDampVelocitySplit":0.15,"beamDampFast":800,"dampCutoffHz":500}],
		["fh3l","fx1l", {"beamDampVelocitySplit":0.15,"beamDampFast":800,"dampCutoffHz":500}],
		["fh5r","fx2r", {"beamDampVelocitySplit":0.15,"beamDampFast":800,"dampCutoffHz":500}],
		["fh5l","fx2l", {"beamDampVelocitySplit":0.15,"beamDampFast":800,"dampCutoffHz":500}],
		//additional damping
		{"beamSpring":0,"beamDamp":150},
		["fh3r","st2l"],
		["fh3l","st2r"],
		["fh5r","fx2l"],
		["fh5l","fx2r"],

		//--Limiter--
		//steering limit
		{"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":2},
		{"beamSpring":2501000,"beamDamp":250,"beamDeform":925000,"beamStrength":"FLT_MAX"},
		{"beamPrecompression":0.80},
		["fh3r","fx1r"],
		["fh3l","fx1l"],
		{"beamPrecompression":0.86},
		["fh5r","fx2r"],
		["fh5l","fx2l"],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
	"torsionbars": [
		["id1:", "id2:", "id3:", "id4:"],
		{"spring":100000, "damp":1, "deform":25000, "strength":100000},
		//rigidify steering arm
		["fw1rr", "fh2r", "fh3r", "fh1r"],
		["fw1ll", "fh2l", "fh3l", "fh1l"],
		//["fw1r", "fw1rr", "fh1r", "fh5r"],
		//["fw1l", "fw1ll", "fh1l", "fh5l"],
	],
	"hydros": [
		["id1:","id2:"],
		{"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":12001000,"beamDamp":80,"beamDeform":"FLT_MAX","beamStrength":135000},
		["st2l","st1r", {"factor":"$= $components.steering.limiter","steeringWheelLock":"$steer_lock", "inRate":1.5,"outRate":1.5}],
		["st2r","st1l", {"factor":"$=-$components.steering.limiter","steeringWheelLock":"$steer_lock", "inRate":1.5,"outRate":1.5}],
		{"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1}
	],
	"input": {
		//modifier for force feedback to account for differences in vehicles
		"FFBcoef":"$=10.4*$ffbTune"
	}
},
"Astral_wheeldata_F": {
	"information":{
		"authors":"Un1corn",
		"name":"Front Spindles",
		"value":10
	},
	"slotType" : "Astral_wheeldata_F",
	"pressureWheels":[
		["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
		//some wheel properties
		{"selfCollision":false},
		{"collision":true},
		{"hubcapBreakGroup":"hubcap_FR"},
		{"hubcapGroup":"hubcap_FR"},
		{"axleBeams":["axle_FR"]},
		//wheels are created from here, but using properties from previously loaded wheel parts
		["FR", "wheel_FR", "tire_FR", "fw1rr", "fw1r", 9999, "fh5r",  1, {"torqueCoupling:":"fh1r", "torqueArm:":"fh2r", "torqueArm2:":"fw1rr","torqueJointNode1:":"ftrar","torqueJointNode2:":"ftral","steerAxisUp:":"fs1r","steerAxisDown:":"fh1r"}],
		{"hubcapBreakGroup":"hubcap_FL"},
		{"hubcapGroup":"hubcap_FL"},
		{"axleBeams":["axle_FL"]},
		["FL", "wheel_FL", "tire_FL", "fw1ll", "fw1l", 9999, "fh5l", -1, {"torqueCoupling:":"fh1l", "torqueArm:":"fh2l", "torqueArm2:":"fw1ll","torqueJointNode1:":"ftral","torqueJointNode2:":"ftrar","steerAxisUp:":"fs1l","steerAxisDown:":"fh1l"}],
		//cancel out a bunch of properties before future wheel parts are loaded
		{"selfCollision":true},
		{"axleBeams":[]},
		{"disableMeshBreaking":false,"disableTriangleBreaking":false},
		{"hubcapBreakGroup":""},
		{"hubcapGroup":""},
		{"enableHubcaps":false}
	],
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["shaft", "spindleFL", "wheelaxleFL", 1, {"connectedWheel":"FL", "breakTriggerBeam":"axle_FL", "uiName":"Front Left Axle", "friction":0.99, "dynamicFriction":0.003}],
		["shaft", "spindleFR", "wheelaxleFR", 1, {"connectedWheel":"FR", "breakTriggerBeam":"axle_FR", "uiName":"Front Right Axle", "friction":0.99, "dynamicFriction":0.003}],
	]
},
