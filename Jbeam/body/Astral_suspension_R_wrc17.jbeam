"Astral_shim_R_wrc17_tarmac_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_wrc17_tarmac",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_bump_R", "range", "Clicks", "Suspension - Dampers and Springs", 3950, 2750, 5150, "LS Bump", "Low speed bump damping controls car dynamics and small bump absorption", {"stepDis":1,"minDis":-24,"maxDis":0,"subCategory":"Rear Damper - 3+2-Way"}],
