{
"Astral_group_F_rally1_tarmac": {
	"information":{
		"authors":"Un1corn",
		"name":"CTM MRA80 (Mod)",
		"value":3200,
	},
	"slotType" : "Astral_group_F",
	"slots2" : [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_hubs_F", ["Astral_hubs_F"], [], "Astral_hubs_F_wrc17", "Hub", {"nodeOffset":{"x":"$=0.356+$TrackFront", "y":-1.3, "z":0.17}}],
		["Astral_brake_F", ["Astral_brake_F"], [], "Astral_brake_F_370", "Brake Disc", {"nodeOffset":{"x":0, "y":-1.3, "z":0.17}}],
		["Astral_spring_F_wrc17_tarmac", ["Astral_spring_F_wrc17_tarmac"], [], "Astral_spring_F_wrc17_tarmac_49", "Spring"],
		["Astral_shim_F_wrc17_tarmac", ["Astral_shim_F_wrc17_tarmac"], [], "Astral_shim_F_wrc17_tarmac_l", "Shim Stacks", {"coreSlot":true}],
	],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["Astral_arm_f4", ["Astral_arm_F"]],
		["Astral_rod_f4", ["Astral_rod_F"]],
		["Astral_arb_f4", ["Astral_arb2_F"]],
		["Astral_hub_f4", ["Astral_hub_FR","Astral_hub_FL"]],
		["Astral_damper_platform_f4", ["Astral_damper_F"]],
		["Astral_damper_piston_f4", ["Astral_piston_F"]],
		["Astral_trans_f4", ["axf_L","axf_R","Astral_transmission","Astral_arm_F"]],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_stop_F", "range", "Clicks", "Suspension - Dampers and Springs", 8000, 6000, 10000, "HBS Damping", "HBS damping stiffness", {"stepDis":1,"minDis":-8,"maxDis":0,"subCategory":"Front Damper - 3+2-Way"}],
		["$dampRateRebound_stop_F", "range", "Clicks", "Suspension - Dampers and Springs", 4000, 2000, 6000, "HRS Damping", "HRS damping stiffness", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Front Damper - 3+2-Way"}],
		["$dampPos_hystop_F", "range", "mm", "Suspension - Dampers and Springs", 0.030, 0.025, 0.035, "HBS Travel", "Adjust hydraulic bump stop's travel length", {"stepDis":1,"minDis":25,"maxDis":35,"subCategory":"Front Damper Internal"}],
		["$dampGas_F", "range", "PSI", "Suspension - Dampers and Springs", 225, 150, 250, "Gas Internal Pressure", "The pressure of nitrogen gas inside damper", {"stepDis":25,"subCategory":"Front Damper Internal"}],
		["$RideHeightOffsetFront", "range", "mm", "Suspension - Dampers and Springs", 0.012, 0.000, 0.033, "Spring Collar Offset", "Changes the platform height", {"stepDis":3,"minDis":-12,"maxDis":21,"subCategory":"Front Damper - 3+2-Way"}], //fg3 node from the ground about 108mm
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"collision":true},
		{"selfCollision":true},
		{"nodeMaterial":"|NM_METAL"},
		//--Hub--
		//hub mounting points for control arm
		{"nodeWeight":8.5},
		["fh1r", -0.752, -1.295, 0.021, {"group":["Astral_hub_FR","Astral_arm_F"]}],
		["fh1l",  0.752, -1.295, 0.021, {"group":["Astral_hub_FL","Astral_arm_F"]}],
		//strut attach
		{"nodeWeight":4.75},
		["fh2r", -0.6033, -1.304, 0.36, {"group":["Astral_hub_FR","Astral_damper_F"]}],
		["fh2l",  0.6033, -1.304, 0.36, {"group":["Astral_hub_FL","Astral_damper_F"]}],
		//tie rod end
		{"nodeWeight":5.25},
		["fh3r", -0.747, -1.152, "$=0.0511", {"group":["Astral_hub_FR","Astral_rod_F"]}],
		["fh3l",  0.747, -1.152, "$=0.0511", {"group":["Astral_hub_FL","Astral_rod_F"]}],
		//brake caliper
		{"nodeWeight":"$=4.0*$brakeThickness_F"},
		["fh5r", -0.805, -1.468, 0.188, {"group":["Astral_hub_FR","Astral_duct_F"]}],
		["fh5l",  0.805, -1.468, 0.188, {"group":["Astral_hub_FL","Astral_duct_F"]}],

		//--Steering Rack--
		//steering rack ends
		{"nodeWeight":5.5},
		{"group":["Astral_rod_F"]},
		["st2r", -0.2495, -1.094, "$=0.130+$shimRack_F", {"selfCollision":false}],
		["st2l",  0.2495, -1.094, "$=0.130+$shimRack_F", {"selfCollision":false}],

		//--Arm--
		//arb end link
		{"nodeWeight":1.25},
		{"group":["Astral_arb2_F"]},
		["farb3r", -0.465, -1.1037, 0.0712, {"selfCollision":false}],
		["farb3l",  0.465, -1.1037, 0.0712, {"selfCollision":false}],
		{"selfCollision":true},

		//--Strut--
		//damper top point
		{"group":["Astral_piston_F","Astral_spring_F","Astral_chassis_F"]},
		{"nodeWeight":8.25},
		["fs1r", -0.581, -1.22, 0.815],
		["fs1l",  0.581, -1.22, 0.815],
		//lower spring collar
		{"group":["Astral_helper_F"]},
		{"nodeWeight":0.4},
		{"selfCollision":false},
		["fcl1r", -0.6005, -1.2933, 0.418],
		["fcl1l",  0.6005, -1.2933, 0.418],
		//piston outer shell to mount LRS
		{"group":["Astral_piston_F"]},
		{"nodeWeight":0.1},
		["fps1r", -0.5928, -1.2643, 0.575],
		["fps1l",  0.5928, -1.2643, 0.575],
		//mass
		{"group":[""]},
		{"nodeWeight":0.1},
		["fmassr", -0.608, -1.31, 0.32],
		["fmassl",  0.608, -1.31, 0.32],
		//["fmass2r", -0.587, -1.243, 0.69],
		//["fmass2l",  0.587, -1.243, 0.69],
		//damper end
		{"nodeWeight":3.85},
		{"group":["Astral_damper_F"]},
		["fs2r", -0.611, -1.333, 0.203],
		["fs2l",  0.611, -1.333, 0.203],
		//damper flexbodu stuff
		{"collision":false},
		{"nodeWeight":0.1},
		{"group":["Astral_damper_F"]},
		["fs3r", -0.486, -1.371, 0.315, {"selfCollision":false}],
		["fs3l",  0.486, -1.371, 0.315, {"selfCollision":false}],
		{"group":[""]},
		{"collision":true},
		{"selfCollision":true}
	],
	"rails": {
		//strut shaft rail
		"strut_FR":{"links:":["fs2r", "fs1r"], "broken:":[], "looped":false, "capped":true},
		"strut_FL":{"links:":["fs2l", "fs1l"], "broken:":[], "looped":false, "capped":true},
		//strut body shell
		"strut2_FR":{"links:":["fs2r", "fh2r"], "broken:":[], "looped":false, "capped":true},
		"strut2_FL":{"links:":["fs2l", "fh2l"], "broken:":[], "looped":false, "capped":true},
		//arb mounting rail
		"arb_FR":{"links:":["fh1r", "fx2r"], "broken:":[], "looped":false, "capped":true},
		"arb_FL":{"links:":["fh1l", "fx2l"], "broken:":[], "looped":false, "capped":true}
		//steering rack
		"steeringrack":{"links:":["st2r", "st2l"], "broken:":[], "looped":false, "capped":true}
	},
	"slidenodes": [
		["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
		//attach strut body to strut shaft rail
		["fh2r", "strut_FR", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["fh2l", "strut_FL", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["fcl1r", "strut_FR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		["fcl1l", "strut_FL", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		//spring collar
		["fhe1r", "strut_FR", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		["fhe1l", "strut_FL", true, true, 0.0, 1001000, "FLT_MAX", "FLT_MAX"],
		//piston
		["fps1r", "strut_FR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["fps1l", "strut_FL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//mass
		["fmassr", "strut2_FR", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		["fmassl", "strut2_FL", true, true, 0.0, 200100, "FLT_MAX", "FLT_MAX"],
		//arb mounting point
		["farb3r", "arb_FR", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"],
		["farb3l", "arb_FL", true, true, 0.0, 3501000, "FLT_MAX", "FLT_MAX"]
		//steering arm
		["st1r", "steeringrack", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"],
		["st1l", "steeringrack", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"]
	],
	"beams": [
		["id1:", "id2:"],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Hub and Wheel--
		//camber
		{"beamSpring":6001000,"beamDamp":150},
		{"breakGroup":"wheel_FR"},
		["fh2r","fw1rr", {"precompressionRange":"$=$CamberFront*2.32-0.0036","beamPrecompressionTime":0.2}],
		{"breakGroup":"wheel_FL"},
		["fh2l","fw1ll", {"precompressionRange":"$=$CamberFront*2.32-0.0036","beamPrecompressionTime":0.2}],
		{"breakGroup":""},
		{"optional":false},

		//--Control arm--
		//tie rods
		{"beamSpring":18001000,"beamDamp":400},
		{"beamDeform":235100,"beamStrength":625000},
		["fh3r","st2r", {"precompressionRange":"$=$toe_F-$steer_center_F-0.0008","beamPrecompressionTime":0.2,"dampCutoffHz":1000}],
		["fh3l","st2l", {"precompressionRange":"$=$toe_F+$steer_center_F-0.0008","beamPrecompressionTime":0.2,"dampCutoffHz":1000}],
		//arb mount point
		{"beamSpring":1501000,"beamDamp":150},
		{"beamDeform":30000,"beamStrength":"FLT_MAX"},
		["farb3r","fx2r", {"precompressionRange":"$=$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3l","fx2l", {"precompressionRange":"$=$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3r","fh1r", {"precompressionRange":"$=0-$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3l","fh1l", {"precompressionRange":"$=0-$arb_point_F*0.45", "beamPrecompressionTime":0.2}],

		//--Springs--
		//main spring
		{"optional":true},
		{"beamSpring":"$=$components.springs.kF","beamDamp":25},
		{"beamDeform":155000,"beamStrength":305000},
		["fhe1r","fs1r", {
			"name":"spring_FR",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthF","beamPrecompressionTime":0.3}
		],
		["fhe1l","fs1l", {
			"name":"spring_FL",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthF","beamPrecompressionTime":0.3}
		],
		//helper spring
		{"beamSpring":2500,"beamDamp":10},
		["fhe1r","fcl1r", {"precompressionRange":0.054,"beamPrecompressionTime":0.3}],
		["fhe1l","fcl1l", {"precompressionRange":0.054,"beamPrecompressionTime":0.3}],
		//helper stopper
		{"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":100, "beamShortBound":100},
		{"beamSpring":1001000,"beamDamp":50},
		["fhe1r","fcl1r", {"precompressionRange":-0.101,"beamPrecompressionTime":0.3}],
		["fhe1l","fcl1l", {"precompressionRange":-0.101,"beamPrecompressionTime":0.3}],
		{"optional":false},

		//--Damper Hydraulics--
		//damper internal gas preload
		{"beamPrecompression":1, "beamType":"|PRESSURED"},
		{"beamSpring":"$=4.11*$dampGas_F","beamDamp":3.6}, //k=(1.4*A^2*P)/V, 100mm length, 44 diameter
		{"beamLimitSpring":0,"beamLimitDamp":0},
		["fh2r","fs1r", {"pressurePSI":"$dampGas_F","surface":0.00025447,"volumeCoef":0}], //shaft rod diameter 18mm
		["fh2l","fs1l", {"pressurePSI":"$dampGas_F","surface":0.00025447,"volumeCoef":0}],
		//main damper
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"beamDeform":225000,"beamStrength":"FLT_MAX"},
		["fs2r","fs1r", { //bottom out
			"longBoundRange":0.01,"shortBoundRange":0.200,"boundZone":0.01, //longBound when rubber rebound stop failed (highly unlikely), shortBound includes rubber bump stop
			"beamLimitSpring":801000,									  //total piston travel equals to longBound + shortBound
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,											//effective damping travel is less than piston travel since hard stops are there
			"dampCutoffHz":500}
		],
		["fs2l","fs1l", {
			"longBoundRange":0.01,"shortBoundRange":0.200,"boundZone":0.01,
			"beamLimitSpring":801000,
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,
			"dampCutoffHz":500}
		],
		["fs2r","fs1r", { //hard bump
			"longBoundRange":1,"shortBoundRange":0.185,"boundZone":0.01, //15mm hard stop for protection
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["fs2l","fs1l", {
			"longBoundRange":1,"shortBoundRange":0.185,"boundZone":0.01,
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["fs2r","fs1r", { //hard (elastic) rebound
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005, //10mm hard stop for protection
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		["fs2l","fs1l", {
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005,
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_FR"},
		{"beamDeform":125000,"beamStrength":175000},
		["fh2r","fs1r", { //FR damper
			"name":"damper_FR",
			//LS Control
			"beamDamp":"$dampRate_bump_F",
			"beamDampRebound":"$=$dampRate_rebound_F",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_F_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_F",
			"dampCutoffHz":500}
		],
		["fh2r","fs1r", { //1-phase valve close HBS with internal compression spring
			"name":"bumpstop_FR",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.200-$dampPos_hystop_F","boundZone":"$=$dampPos_hystop_F-0.002",
			"beamLimitSpring":150,
			"beamLimitDamp":"$=$dampRate_stop_F-($dampRate_bump_F*0.17)",
			"beamLimitDampRebound":250
			"dampCutoffHz":250}
		],
		["fh2r","fs1r", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.200-$dampPos_hystop_F","boundZone":0.01,
			"beamLimitSpring":20010}
		],
		["fh2r","fs1r", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.012,
			//leave rebound stop space
			"precompressionRange":-0.012,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":150,
			"beamLimitDampRebound":"$dampRateRebound_stop_F",
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_FL"},
		{"beamDeform":125000,"beamStrength":175000},
		["fh2l","fs1l", { //Fl damper
			"name":"damper_FL",
			//LS Control
			"beamDamp":"$dampRate_bump_F",
			"beamDampRebound":"$=$dampRate_rebound_F",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_F_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_F",
			"dampCutoffHz":500}
		],
		["fh2l","fs1l", { //1-phase valve close HBS with internal compression spring
			"name":"bumpstop_FL",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			"longBoundRange":1,"shortBoundRange":"$=0.200-$dampPos_hystop_F","boundZone":"$=$dampPos_hystop_F-0.002",
			"beamLimitSpring":150,
			"beamLimitDamp":"$=$dampRate_stop_F-($dampRate_bump_F*0.17)",
			"beamLimitDampRebound":250
			"dampCutoffHz":250}
		],
		["fh2l","fs1l", {
			//bump spring
			"longBoundRange":1,"shortBoundRange":"$=0.200-$dampPos_hystop_F","boundZone":0.01,
			"beamLimitSpring":20010}
		],
		["fh2l","fs1l", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.012,
			//leave rebound stop space
			"precompressionRange":-0.012,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":150,
			"beamLimitDampRebound":"$dampRateRebound_stop_F",
			"dampCutoffHz":250}
		],
		{"breakGroup":""},

		//--Detection Mass--
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		//LRS
		{"breakGroup":"damper_FR"}
		["fmassr", "fs2r", {"name":"LRS_FR"}],
		["fmassr", "fh2r", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"breakGroup":"damper_FL"}
		["fmassl", "fs2l", {"name":"LRS_FL"}],
		["fmassl", "fh2l", { //hysteresis
			"beamSpring":250,
			"beamDamp":2.5,
			"beamDampRebound":25,
			"longBoundRange":0,"shortBoundRange":0.01,"boundZone":0.005,
			"beamLimitSpring":100000,
			"beamLimitDamp":100,
			"beamLimitRebound":100
			}
		],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
	"pressureWheels": [
		["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
		//cancel out brake properties before future wheel parts are loaded
		{"brakeTorque":0},
		{"parkingTorque":0},
		{"enableBrakeThermals":false},
		{"brakeDiameter":false},
		{"brakeMass":false},
		{"brakeType":false},
		{"rotorMaterial":false},
		{"brakeVentingCoef":false},
	],
	"components": {
		"brakes":{
			"ductMesh":"Astral_brakeduct_f4",
			"ductPosY":-1.3
			"ductPosZ": 0.15
		},
		"steering":{
			"limiter":0.212,
		},
	}
},
"Astral_group_F_rally1_gravel": {
	"information":{
		"authors":"Un1corn",
