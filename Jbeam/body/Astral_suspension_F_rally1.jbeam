		["st1l", "steeringrack", true, true, 0.0, 18001000, "FLT_MAX", "FLT_MAX"]
	],
	"beams": [
		["id1:", "id2:"],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Hub and Wheel--
		//camber
		{"beamSpring":6001000,"beamDamp":150},
		{"breakGroup":"wheel_FR"},
		["fh2r","fw1rr", {"precompressionRange":"$=$CamberFront*1.54+0.0032","beamPrecompressionTime":0.2}],
		{"breakGroup":"wheel_FL"},
		["fh2l","fw1ll", {"precompressionRange":"$=$CamberFront*1.54+0.0032","beamPrecompressionTime":0.2}],
		{"breakGroup":""},
		{"optional":false},

		//--Control arm--
		//tie rods
		{"beamSpring":18001000,"beamDamp":400},
		{"beamDeform":235100,"beamStrength":625000},
		["fh3r","st2r", {"precompressionRange":"$=$toe_F-$steer_center_F+0.0003","beamPrecompressionTime":0.2,"dampCutoffHz":1000}],
		["fh3l","st2l", {"precompressionRange":"$=$toe_F+$steer_center_F+0.0003","beamPrecompressionTime":0.2,"dampCutoffHz":1000}],
		//arb mount point
		{"beamSpring":1501000,"beamDamp":150},
		{"beamDeform":30000,"beamStrength":"FLT_MAX"},
		["farb3r","fx2r", {"precompressionRange":"$=$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3l","fx2l", {"precompressionRange":"$=$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3r","fh1r", {"precompressionRange":"$=0-$arb_point_F*0.45", "beamPrecompressionTime":0.2}],
		["farb3l","fh1l", {"precompressionRange":"$=0-$arb_point_F*0.45", "beamPrecompressionTime":0.2}],

		//--Springs--
		//main spring
		{"optional":true},
		{"beamSpring":"$=$components.springs.kF","beamDamp":25},
		{"beamDeform":155000,"beamStrength":305000},
		["fhe1r","fs1r", {
			"name":"spring_FR",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthF","beamPrecompressionTime":0.3}
		],
		["fhe1l","fs1l", {
			"name":"spring_FL",
			"soundFile":"event:>Vehicle>Suspension>car_sports_01>spring_compress_01",
			"colorFactor":0.55,
			"attackFactor":30,
			"volumeFactor":1.25,
			"decayFactor":10,
			"pitchFactor":0.7,
			"maxStress":2500,
			"precompressionRange":"$=$components.springs.lengthF","beamPrecompressionTime":0.3}
		],
		//helper spring
		{"beamSpring":2500,"beamDamp":10},
		["fhe1r","fcl1r", {"precompressionRange":0.091,"beamPrecompressionTime":0.3}],
		["fhe1l","fcl1l", {"precompressionRange":0.091,"beamPrecompressionTime":0.3}],
		//helper stopper
		{"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":100, "beamShortBound":100},
		{"beamSpring":1001000,"beamDamp":50},
		["fhe1r","fcl1r", {"precompressionRange":-0.064,"beamPrecompressionTime":0.3}],
		["fhe1l","fcl1l", {"precompressionRange":-0.064,"beamPrecompressionTime":0.3}],
		{"optional":false},

		//--Damper Hydraulics--
		//damper internal gas preload
		{"beamPrecompression":1, "beamType":"|PRESSURED"},
		{"beamSpring":"$=4.11*$dampGas_F","beamDamp":3.6}, //k=(1.4*A^2*P)/V, 100mm length, 44 diameter
		{"beamLimitSpring":0,"beamLimitDamp":0},
		["fh2r","fs1r", {"pressurePSI":"$dampGas_F","surface":0.00025447,"volumeCoef":0}], //shaft rod diameter 18mm
		["fh2l","fs1l", {"pressurePSI":"$dampGas_F","surface":0.00025447,"volumeCoef":0}],
		//main damper
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"beamDeform":225000,"beamStrength":"FLT_MAX"},
		["fs2r","fs1r", { //bottom out
			"longBoundRange":0.01,"shortBoundRange":0.260,"boundZone":0.01, //longBound when rubber rebound stop failed (highly unlikely), shortBound includes rubber bump stop
			"beamLimitSpring":801000,									  //total piston travel equals to longBound + shortBound
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,											//effective damping travel is less than piston travel since hard stops are there
			"dampCutoffHz":500}
		],
		["fs2l","fs1l", {
			"longBoundRange":0.01,"shortBoundRange":0.260,"boundZone":0.01,
			"beamLimitSpring":801000,
			"beamLimitDamp":1000,
			"beamLimitDampRebound":1000,
			"dampCutoffHz":500}
		],
		["fs2r","fs1r", { //hard bump
			"longBoundRange":1,"shortBoundRange":0.250,"boundZone":0.01, //10mm hard stop for protection
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["fs2l","fs1l", {
			"longBoundRange":1,"shortBoundRange":0.250,"boundZone":0.01,
			"beamLimitSpring":204100
			"beamLimitDamp":5227,
			"beamLimitDampRebound":7421,
			"dampCutoffHz":250}
		],
		["fs2r","fs1r", { //hard (elastic) rebound
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005, //10mm hard stop for protection
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		["fs2l","fs1l", {
			"longBoundRange":0,"shortBoundRange":1,"boundZone":0.005,
			"beamLimitSpring":154114,
			"beamLimitDamp":6625,
			"beamLimitDampRebound":4750,
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_FR"},
		{"beamDeform":125000,"beamStrength":175000},
		["fh2r","fs1r", { //FR damper
			"name":"damper_FR",
			//LS Control
			"beamDamp":"$dampRate_bump_F",
			"beamDampRebound":"$=$dampRate_rebound_F",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_F_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_F",
			"dampCutoffHz":500}
		],
		["fh2r","fs1r", { //2-phase valve close HBS with stepping internal compression springs
			"name":"bumpstop_FR",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.270-$dampPos_hystop_F","boundZone":"$=$dampPos_hystop_F-0.002",
			"beamLimitSpring":150,
			"beamLimitDamp":"$=$dampRate_stop_F-($dampRate_bump_F*0.17)",
			"beamLimitDampRebound":250
			"dampCutoffHz":250}
		],
		["fh2r","fs1r", { //phase 2
			"longBoundRange":1,"shortBoundRange":"$=0.270-$dampPos_hystop_F+0.002","boundZone":0.01,
			"beamLimitSpring":18500}
		],
		["fh2r","fs1r", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.018,
			//leave rebound stop space
			"precompressionRange":-0.018,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":150,
			"beamLimitDampRebound":"$dampRateRebound_stop_F",
			"dampCutoffHz":250}
		],
		{"breakGroup":"damper_FL"},
		{"beamDeform":125000,"beamStrength":175000},
		["fh2l","fs1l", { //Fl damper
			"name":"damper_FL",
			//LS Control
			"beamDamp":"$dampRate_bump_F",
			"beamDampRebound":"$=$dampRate_rebound_F",
			//HS bump
			"beamDampVelocitySplit":1, //overwritten by LRS stack
			"beamDampFast":"$dampRate_bump_F_fast",
			//HS rebound
			"beamDampReboundFast":"$=$dampRate_rebound_F",
			"dampCutoffHz":500}
		],
		["fh2l","fs1l", { //2-phase valve close HBS with stepping internal compression springs
			"name":"bumpstop_FL",
			"soundFile":"event:>Vehicle>Suspension>longTravel_offroad_01>bump_stop_01",
			"colorFactor":1,
			"attackFactor":50,
			"volumeFactor":2.75,
			"decayFactor":10,
			"pitchFactor":5
			"maxStress":1
			//bump stop active
			"longBoundRange":1,"shortBoundRange":"$=0.270-$dampPos_hystop_F","boundZone":"$=$dampPos_hystop_F-0.002",
			"beamLimitSpring":150,
			"beamLimitDamp":"$=$dampRate_stop_F-($dampRate_bump_F*0.17)",
			"beamLimitDampRebound":250
			"dampCutoffHz":250}
		],
		["fh2l","fs1l", { //phase 2
			"longBoundRange":1,"shortBoundRange":"$=0.270-$dampPos_hystop_F+0.002","boundZone":0.01,
			"beamLimitSpring":18500}
		],
		["fh2l","fs1l", { //hydraulic rebound stop
			"longBoundRange":0,"shortBoundRange":2,"boundZone":0.018,
			//leave rebound stop space
			"precompressionRange":-0.018,
			"beamPrecompressionTime":0.1,
			//rebound stop active
			"beamLimitSpring":50,
			"beamLimitDamp":150,
			"beamLimitDampRebound":"$dampRateRebound_stop_F",
			"dampCutoffHz":250}
		],
		{"breakGroup":""},

		//--Detection Mass--
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		//LRS
		{"breakGroup":"damper_FR"}
		["fmassr", "fs2r", {"name":"LRS_FR"}],
		["fmassr", "fh2r", { //hysteresis
