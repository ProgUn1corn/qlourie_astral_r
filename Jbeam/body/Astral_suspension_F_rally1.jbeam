	"slotType" : "Astral_group_F",
	"slots2" : [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_hubs_F", ["Astral_hubs_F"], [], "Astral_hubs_F_wrc17", "Hub", {"nodeOffset":{"x":"$=0.325+$TrackFront", "y":-1.3, "z":0.083}}],
		["Astral_brake_F", ["Astral_brake_F"], [], "Astral_brake_F_300", "Brake Disc", {"nodeOffset":{"x":0.025, "y":-1.3, "z":0.083}}],
