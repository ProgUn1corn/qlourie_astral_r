{
"Astral_differential_F_race": {
	"information":{
		"name":"1.5-Way Clutch-Type LSD",
		"value":1500
	},
	"slotType" : "Astral_differential_F",
	"slots2": [
		["name"               , "allowTypes"           , "denyTypes", "default"                  , "description"],
		["Astral_halfshafts_F", ["Astral_halfshafts_F"], []         , "Astral_halfshafts_F"      , "Front Halfshafts"],
		["Astral_ramp_F"      , ["Astral_ramp_F"]      , []         , "Astral_ramp_F_5072"       , "Front Ramp Set"   , {"coreSlot":true}]
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$lsdpreload_F", "range", "Nm", "Differentials", 60, 0, 120, "Preload Torque", "lsdpreload_F", {"stepDis":5, "subCategory":"Front"}],
		["$frictionFace_F", "range", "Faces", "Differentials", 6, 4, 6, "Friction Face", "frictionFace_F", {"stepDis":1, "subCategory":"Front"}]
	],
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["torsionReactor", "torsionReactorF", "transfercase", 2],
		["differential", "differential_F", "torsionReactorF", 1, {"diffType":"lsd", "gearRatio":1, "lsdPreload":"$lsdpreload_F", "lsdLockCoef":"$=$components.diff.flock", "lsdRevLockCoef":"$=$components.diff.frevlock", "uiName":"Front Differential","defaultVirtualInertia":0.25}],
	]
	"differential_F": {
		"friction": 2.94,
		"dynamicFriction": 0.000947,
		"torqueLossCoef": 0.0196,
	},
	"torsionReactorF": {
		"torqueReactionNodes:":["eg1","eg0","eg4"],
	}
},
"Astral_ramp_F_h": {
	"information":{
		"name":"46/80 (Coupled with 46/70)",
		"value":1000
	},
	"slotType" : "Astral_ramp_F",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$coastRamp_F", "range", "Degrees", "Differentials", 80, 70, 80, "Coast Ramp Angle", "coastRamp_F", {"stepDis":10, "subCategory":"Front"}]
	],
	"components": {
		"diff":{
			"flock":"$=0.35*($frictionFace_F/8)/tan((46+5)*pi/180)",
			"frevlock":"$=0.35*($frictionFace_F/8)/tan(($coastRamp_F+5)*pi/180)"
		},
	}
},
