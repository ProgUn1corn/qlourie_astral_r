{
"Astral_differential_F_race": {
	"information":{
		"name":"1.5-Way Clutch-Type LSD",
		"value":1500
	},
	"slotType" : "Astral_differential_F",
	"slots2": [
		["name"               , "allowTypes"           , "denyTypes", "default"                  , "description"],
		["Astral_halfshafts_F", ["Astral_halfshafts_F"], []         , "Astral_halfshafts_F"      , "Front Halfshafts"],
		["Astral_finaldrive_F", ["Astral_finaldrive_F"], []         , "Astral_finaldrive_F_wrc17", "Front Final Drive", {"coreSlot":true}],
		["Astral_ramp_F"      , ["Astral_ramp_F"]      , []         , "Astral_ramp_F_5072"       , "Front Ramp Set"   , {"coreSlot":true}]
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$lsdpreload_F", "range", "Nm", "Differentials", 40, 0, 120, "Preload Torque", "Initial locking torque between left and right wheels", {"stepDis":5, "subCategory":"Front"}],
		["$frictionFace_F", "range", "Faces", "Differentials", 6, 4, 6, "Friction Face", "Adjust locking ratio with different number of pads", {"stepDis":1, "subCategory":"Front"}]
	],
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["torsionReactor", "torsionReactorF", "transfercase", 2],
		["differential", "differential_F", "torsionReactorF", 1, {"diffType":"lsd", "gearRatio":1, "lsdPreload":"$=$lsdpreload_F*(1+($frictionFace_F-6)*0.048)", "lsdLockCoef":"$=$components.diff.flock", "lsdRevLockCoef":"$=$components.diff.frevlock", "uiName":"Front Differential","defaultVirtualInertia":0.25}],
	]
	"differential_F": {
		"friction": 2.94,
		"dynamicFriction": 0.000947,
		"torqueLossCoef": 0.0196,
	},
	"torsionReactorF": {
		"torqueReactionNodes:":["eg1","eg0","eg4"],
	}
},
"Astral_ramp_F_h": {
	"information":{
		"name":"45/85 (Coupled with 45/70)",
		"value":1000
	},
	"slotType" : "Astral_ramp_F",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$coastRamp_F", "range", "Degrees", "Differentials", 70, 70, 85, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":15, "subCategory":"Front"}]
	],
	"components": {
		"diff":{
			"flock":"$=(1/tan(45*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
			"frevlock":"$=(1/tan($coastRamp_F*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)"
		},
	}
},
"Astral_ramp_F_m": {
	"information":{
		"name":"50/85 (Coupled with 50/70)",
		"value":1000
	},
	"slotType" : "Astral_ramp_F",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$coastRamp_F", "range", "Degrees", "Differentials", 70, 70, 85, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":15, "subCategory":"Front"}]
	],
	"components": {
		"diff":{
			"flock":"$=(1/tan(50*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
			"frevlock":"$=(1/tan($coastRamp_F*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
		},
	}
},
"Astral_ramp_F_l": {
	"information":{
		"name":"62/85",
		"value":1000
	},
	"slotType" : "Astral_ramp_F",
	"components": {
		"diff":{
			"flock":"$=(1/tan(62*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
			"frevlock":"$=(1/tan(85*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)"
		},
	}
},
"Astral_ramp_F_d": {
	"information":{
		"name":"Adjustable Debug Ramp",
		"value":1000
		"isAuxiliary":true
	},
	"slotType" : "Astral_ramp_F",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$powerRamp_F", "range", "Degrees", "Differentials", 50, 30, 65, "Power Ramp Angle", "Adjust power side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Front"}]
		["$coastRamp_F", "range", "Degrees", "Differentials", 70, 50, 90, "Coast Ramp Angle", "Adjust coast side ramp coupled in the ramp set", {"stepDis":1, "subCategory":"Front"}]
	],
	"components": {
		"diff":{
			"flock":"$=(1/tan($powerRamp_F*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
			"frevlock":"$=(1/tan($coastRamp_F*pi/180))/(1/tan(35*pi/180))*0.37*(1+($frictionFace_F-8)*0.114)",
		},
	}
},
"Astral_halfshafts_F": {
