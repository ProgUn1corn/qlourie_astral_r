		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$idleRPM", "range", "RPM", "Engine and ECU", 2300, 800, 2600, "Idle RPM", "idleRPM", {"subCategory": "ui.vehicleconfig.information.name.Astral.ECU", "stepDis": 50}],
