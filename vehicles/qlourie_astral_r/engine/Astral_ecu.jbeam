		"clutchLaunchTargetRPM": 2500,
	},
	"components":{
		"ECU": {
			"shiftlights": {
				"defaultMm":36,
				"A36":[3000, 6980, 7190, 7250, 7300, 7280, 8500], // N, 1, 2, 3, 4, 5, 6
				"B36":[3000, 7090, 7220, 7250, 7250, 7250, 8500], // Type-B
