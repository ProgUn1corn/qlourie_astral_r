{
"Astral_enginemanagement_wrc17": {
	"information":{
		"name": {
			"txt":"ui.vehicleconfig.generic.Astral.prefixedName",
			"ctx":{
				"prefix":"WRC+",
				"name":"ui.vehicleconfig.information.name.Astral.ECU",
			},
		},
		"value":3600
	},
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$defaultEngineMap", "range", "MAP", "Engine and ECU", 3, 0, 4, "Default Engine Map", "defaultEngineMap", {"stepDis": 1}],
		["$launchRPM1", "range", "RPM", "Engine and ECU", 6500, 4000, 8500, "Launch Control RPM", "launchRPM1", {"subCategory": "Launch Control 1", "stepDis": 50}],
		["$launchRPM2", "range", "RPM", "Engine and ECU", 6900, 4000, 8500, "Launch Control RPM", "launchRPM2", {"subCategory": "Launch Control 2", "stepDis": 50}]
		["$launchRPM3", "range", "RPM", "Engine and ECU", 7200, 4000, 8500, "Launch Control RPM", "launchRPM3", {"subCategory": "Launch Control 3", "stepDis": 50}],
		["$launchTorque1", "range", "%", "Engine and ECU", 100, 0, 100, "Launch Torque Limit", "launchTorqueLimit", {"subCategory": "Launch Control 1", "stepDis": 1}],
		["$launchTorque2", "range", "%", "Engine and ECU", 100, 0, 100, "Launch Torque Limit", "launchTorqueLimit", {"subCategory": "Launch Control 2", "stepDis": 1}],
		["$launchTorque3", "range", "%", "Engine and ECU", 100, 0, 100, "Launch Torque Limit", "launchTorqueLimit", {"subCategory": "Launch Control 3", "stepDis": 1}],
	],
	"slotType" : "Astral_enginemanagement_1",
	"controller": [
		["fileName"],
		["launchControl"],
		["engineMap"],
		["throttleMap", {
			"tMap":2,
			"maps":[
				{"name":"Progressive", "a":0, "k":-0.95},
				{"name":"Subtle Linear", "a":0.25, "k":-0.55},
				{"name":"Aggressive", "a":0.1, "k":1}
			]
		}]
	],
	"launchControl": {
		"presets": [
			{"rpm":"$launchRPM1", "torquePercent":"$launchTorque1"},
			{"rpm":"$launchRPM2", "torquePercent":"$launchTorque2"},
			{"rpm":"$launchRPM3", "torquePercent":"$launchTorque3"}
		]
	},
	"actionsEnabled": [
		["id"],
		["toggleLaunchControl"],
		["nextLaunchPreset"],
		["previousLaunchPreset"],
		["selectLaunchPreset1"],
		["selectLaunchPreset2"],
		["selectLaunchPreset3"],
		["toggleEngineMap"],
		["nextEngineMap"],
		["previousEngineMap"],
		["selectEngineMap1"],
		["selectEngineMap2"],
		["selectEngineMap3"],
		["selectEngineMap4"],
		["selectEngineMap5"],
	],
	"engineMap": {
		"defaultMode": "$defaultEngineMap",
		"defaultSettings": [
			["type"],
			["engine", {"name":"mainEngine", "idleRPM":2300, "idleRPMRoughness":600}]
		],
		"modes": {
			"low": {
				"name": "Stage:1",
				"mapId": 1,
				"settings": [
					["type"],
					["controller", {"controllerName":"throttleMap", "tMap":2}],
					["controller", {"controllerName":"launchControl", "isAllowed":true}],
					["controller", {"controllerName":"dynamicAntiLag", "ALS":0}],
					["controller", {"controllerName":"eWasteGate", "mapOffsetPsi": 0}],
					["controller", {"controllerName":"gauge", "modeName": "Stage:1", "modeColor": "BBBBBB"}],
					["simpleControlButton", {"buttonId":"als", "uiName":"Engine Map: Stage 1","icon":"astral_map_1","color":"BBBBBB"}]
				]
			},
			"med": {
				"name": "Stage:2",
				"mapId": 2,
				"settings": [
					["type"],
					["controller", {"controllerName":"throttleMap", "tMap":2}],
					["controller", {"controllerName":"launchControl", "isAllowed":true}],
					["controller", {"controllerName":"dynamicAntiLag", "ALS":1, "powerCoef":0.14}],
					["controller", {"controllerName":"eWasteGate", "mapOffsetPsi": 0}],
					["controller", {"controllerName":"gauge", "modeName": "Stage:2", "modeColor": "00CCFF"}],
					["simpleControlButton", {"buttonId":"als", "uiName":"Engine Map: Stage 2","icon":"astral_map_2","color":"00CCFF"}]
				]
			},
			"high": {
				"name": "Stage:3",
				"mapId": 3,
				"settings": [
					["type"],
					["controller", {"controllerName":"throttleMap", "tMap":2}],
					["controller", {"controllerName":"launchControl", "isAllowed":true}],
					["controller", {"controllerName":"dynamicAntiLag", "ALS":2, "powerCoef":0.30}],
					["controller", {"controllerName":"eWasteGate", "mapOffsetPsi": 0}],
					["controller", {"controllerName":"gauge", "modeName": "Stage:3", "modeColor": "FFF68F"}],
					["simpleControlButton", {"buttonId":"als", "uiName":"Engine Map: Stage 3","icon":"astral_map_3","color":"FFF68F"}]
				]
			},
			"aggressive": {
				"name": "Stage:4",
				"mapId": 4,
				"settings": [
					["type"],
					["controller", {"controllerName":"throttleMap", "tMap":2}],
					["controller", {"controllerName":"launchControl", "isAllowed":true}],
					["controller", {"controllerName":"dynamicAntiLag", "ALS":3, "powerCoef":1.00}],
					["controller", {"controllerName":"eWasteGate", "mapOffsetPsi": 0}],
					["controller", {"controllerName":"gauge", "modeName": "Stage:4", "modeColor": "FF2701"}],
					["simpleControlButton", {"buttonId":"als", "uiName":"Engine Map: Stage 4","icon":"astral_map_4","color":"FF2701"}]
				]
			},
			"off": {
				"name": "Road",
				"mapId": 0,
				"settings": [
					["type"],
					["controller", {"controllerName":"throttleMap", "tMap":1}],
					["engine", {"name":"mainEngine", "idleRPM":1000, "idleRPMRoughness":50, "maxRPM":6500}],
					["controller", {"controllerName":"launchControl", "isAllowed":false}],
					["controller", {"controllerName":"dynamicAntiLag", "ALS":0}],
					["controller", {"controllerName":"eWasteGate", "mapOffsetPsi": "$=-$components.turbo.boostPSI"}],
					["controller", {"controllerName":"gauge", "modeName": "Road", "modeColor": "BBBBBB"}],
					["simpleControlButton", {"buttonId":"als", "uiName":"Engine Map: Road","icon":"astral_map_0","color":"BBBBBB"}]
				]
			}
		}
	},
	"mainEngine": {
		//RPM
		"hasRevLimiter": true,
		"revLimiterType":"timeBased",
		"revLimiterCutTime":0.10,
		"revLimiterRPM":8500,
		"revLimiterMaxRPMDrop":100
		//"revLimiterSmoothOvershootRPM":100
		//torque
		"torqueModIntake":[
			["rpm", "torque"],
			[0, 0],
			[500, 0],
			[1000, 11],
			[1250, 15],
			[1500, 27],
			[2000, 37],
			[2500, 38],
			[3000, 36],
			[3500, 32],
			[4000, 36],
			[4500, 41],
			[5000, 44],
			[5500, 46],
			[6000, 47],
			[6500, 46],
			[7000, 45],
			[7500, 39],
			[8000, 31],
			[8500, 25],
			[9000, 18],
		],
		//exhaust
		"$*instantAfterFireCoef": 20,
		"$*sustainedAfterFireTime": 6,
		"$*instantAfterFireVolumeCoef":0.45,
		"$*sustainedAfterFireVolumeCoef":0.45,
		"$*shiftAfterFireVolumeCoef":0.5,
	},
	"soundConfigExhaust": {
		"sampleName": "H4DPA_EX",

		"mainGain": -4,
		"onLoadGain": 1,
		"offLoadGain": 0.69,

		"maxLoadMix": 0.69,
		"minLoadMix": 0.02,

		"lowShelfGain": -3,
		"lowShelfFreq": 210,

		"highShelfGain": 6,
		"highShelfFreq": 2500,

		"eqLowFreq": 450,
		"eqLowGain": -9,
		"eqLowWidth": 0.1,

		"eqHighFreq": 10000,
		"eqHighGain": 15,
		"eqHighWidth": 0.27,

		"fundamentalFrequencyCylinderCount": 4,
		"eqFundamentalGain": 0
	},
	"vehicleController": {
		"calculateOptimalLoadShiftPoints":false,
		"highShiftDownRPM":[0,0,0,4500,6200,6200,6200,6200],
		"highShiftUpRPM":[0, 0, 7010, 7180, 7250, 7290, 7280, 8500],
		"wheelSlipUpThreshold":20000,
		"wheelSlipShiftUpSmoothingIn":12,
		"wheelSlipDownThreshold":100000,
		"wheelSlipShiftDownSmoothingIn":20,
		"clutchLaunchStartRPM": 5500,
		"clutchLaunchTargetRPM": 2500,
	},
	"components":{
		"ECU": {
			"shiftlights": {
				"defaultMm":36,
				"A36":[3000, 7010, 7180, 7250, 7290, 7280, 8500], // N, 1, 2, 3, 4, 5, 6
				"B36":[3000, 7130, 7230, 7250, 7260, 7250, 8500], // Type-B
				"rpmRange":[0, 500, 500, 500, 500, 500, 250] // N, 1, 2, 3, 4, 5, 6
			}
		},
		"soundConfigExhaustComponents": {
			"WRC+": {
				"addLowShelfGain":0,
				"addHighShelfGain":0,
				"addEqFundamentalGain":0,
				"addEqHighGain":0,
				"nodeAfterFireAudioCoef":0
				"nodeAfterFireVisualCoef":0,
				"nodeAfterFireVolumeCoef":0,
				"nodeAfterFireMufflingCoef":0.0,
				"nodeExhaustAudioMufflingCoef":0.00,
				"nodeExhaustAudioGainChange":0
			},
		},
	},
	"eWasteGate": {
		"manualOrder":99999, // Publish the shaft target before dynamicAntiLag updates.
		"supplyALSTargetRPM":true,
		"freeRevBoostPsi":1.5,
		// Engine RPM, fraction of base boost at closed and full throttle.
		"closedThrottleBoostByRPM":[
			[4800, 0.00],
			[5000, 0.035],
			[5500, 0.12],
			[6000, 0.30],
			[6500, 0.58],
			[7000, 0.85],
			[8000, 0.87],
		],
		"fullThrottleBoostByRPM":[
			[0, 0.00],
			[2500, 0.65],
			[4000, 0.92],
			[5500, 1.00],
		],
	},
	"turbocharger": {
		"maxAntilagPower":600
	},
},
