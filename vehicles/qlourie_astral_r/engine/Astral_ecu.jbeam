		"eqFundamentalGain": 0
	},
	"vehicleController": {
		"calculateOptimalLoadShiftPoints":false,
		"highShiftDownRPM":[0,0,0,4500,6200,6200,6200,6200],
		"highShiftUpRPM":[0, 0, 6980, 7190, 7250, 7300, 7280, 8500],
