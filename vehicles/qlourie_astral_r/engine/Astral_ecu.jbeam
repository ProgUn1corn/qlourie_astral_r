		["$maxAntiLagThrottle1", "range", "", "Engine and ECU", 0.15, 0, 1, "Anti-Lag Maximum Throttle Input", "maxAntiLagThrottle1", {"subCategory": "Engine Map Stage:1", "minDis":0, "maxDis":100, "stepDis": 1, "hideInUI":true}],
		["$minAntiLagBrake1", "range", "", "Engine and ECU", 0.8, 0, 1, "Anti-Lag Minimum Brake Input", "minAntiLagBrake1", {"subCategory": "Engine Map Stage:1", "minDis":0, "maxDis":100, "stepDis": 1, "hideInUI":true}],
		["$minAntiLagRPM2", "range", "RPM", "Engine and ECU", 3050, 2500, 7500, "Anti-Lag RPM Threshold", "minAntiLagRPM2", {"subCategory": "Engine Map Stage:2", "stepDis": 50, "hideInUI":true}],
		["$maxAntiLagThrottle2", "range", "", "Engine and ECU", 0.35, 0, 1, "Anti-Lag Maximum Throttle Input", "maxAntiLagThrottle2", {"subCategory": "Engine Map Stage:2", "minDis":0, "maxDis":100, "stepDis": 1, "hideInUI":true}],
		["$minAntiLagBrake2", "range", "", "Engine and ECU", 0.55, 0, 1, "Anti-Lag Minimum Brake Input", "minAntiLagBrake2", {"subCategory": "Engine Map Stage:2", "minDis":0, "maxDis":100, "stepDis": 1, "hideInUI":true}],
		["$minAntiLagRPM3", "range", "RPM", "Engine and ECU", 2500, 2500, 7500, "Anti-Lag RPM Threshold", "minAntiLagRPM3", {"subCategory": "Engine Map Stage:3", "stepDis": 50, "hideInUI":true}],
		["$maxAntiLagThrottle3", "range", "", "Engine and ECU", 0.55, 0, 1, "Anti-Lag Maximum Throttle Input", "maxAntiLagThrottle3", {"subCategory": "Engine Map Stage:3", "minDis":0, "maxDis":100, "stepDis": 1, "hideInUI":true}],
