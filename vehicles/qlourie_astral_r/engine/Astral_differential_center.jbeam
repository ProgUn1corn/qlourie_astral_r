{
"Astral_differential_center_e": {
	"information":{
		"authors":"Un1corn",
		"name":"Active Center Differential",
		"value":2500
	},
	"slotType" : "Astral_transfercase",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_transfercase_output", ["Astral_transfercase_output"], [], "Astral_transfercase_output_34_13", "Rear Output Gears", {"coreSlot":true}]
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$torquesplit", "range", "", "Differentials", 0.57, 0.57, 0.63, "Torque Split", "torquesplit",{"subCategory": "Active Map 1.Master", "stepDis":6, "minDis":57,"maxDis":63}]
		["$minLock_C", "range", "", "Differentials", 0.20, 0, 0.5, "Minimum Lock Factor", "minLock_C", {"minDis":0, "maxDis":50, "subCategory":"Active Map 1.Master"}],
		["$lockThrottleTravel_C", "range", "%", "Differentials", 0.86, 0.01, 1, "Throttle Lock Travel", "lockThrottleTravel_C", {"minDis":1, "maxDis":100, "stepDis":1, "subCategory":"Active Map 2.Throttle"}],
		["$lockBrakeTravel_C", "range", "%", "Differentials", 0.71, 0.01, 1, "Brake Lock Travel", "lockBrakeTravel_C", {"minDis":1, "maxDis":100, "stepDis":1, "subCategory":"Active Map 3.Brake"}],
		["$lockThrottleStart_C", "range", "", "Differentials", 0.3, 0, 0.6, "Throttle Lock Start", "lockThrottleStart_C", {"minDis":0, "maxDis":60, "subCategory":"Active Map 2.Throttle"}],
		["$lockBrakeStart_C", "range", "", "Differentials", 0.15, 0, 0.6, "Brake Lock Start", "lockBrakeStart_C", {"minDis":0, "maxDis":60, "subCategory":"Active Map 3.Brake"}],
		["$steeringLockCut_C", "range", "%", "Differentials", 0.4, 0, 1, "Steering Lock Cut", "steeringLockCut_C", {"minDis":0, "maxDis":100, "subCategory":"Active Map 5.Steering"}],
		["$speedMapFactor_C", "range", "%", "Differentials", 0.54, 0, 1, "Speed Map Factor", "speedMapFactor_C", {"minDis":0, "maxDis":100, "subCategory":"Active Map 5.Steering"}],
		["$leftAStart_C", "range", "", "Differentials", 0.15, 0, 0.5, "L.foot Input Threshold", "leftAStart_C", {"minDis":0, "maxDis":50, "subCategory":"Active Map 4.L.foot"}],
		["$leftThrottleGain_C", "range", "", "Differentials", 1, 0, 1, "L.foot Throttle Gain", "leftThrottleGain_C", {"minDis":0, "maxDis":100, "subCategory":"Active Map 4.L.foot"}],
		["$leftBrakeGain_C", "range", "", "Differentials", 1, 0, 1, "L.foot Brake Gain", "leftBrakeGain_C", {"minDis":0, "maxDis":100, "subCategory":"Active Map 4.L.foot"}],
		["$hbRelease", "range", "", "Differentials", 0.4, 0, 1, "Handbrake Release", "hbRelease", {"minDis":0, "maxDis":100, "subCategory":"Active Map 1.Master"}],
		["$preloadMultiplier_C", "range", "x", "Differentials", 40, 15, 60, "Brake Preload Multiplier", "preloadMultiplier_C", {"stepDis":1, "subCategory":"Active Map 1.Master"}],
	],
	"controller": [
		["fileName"],
		["eCenterDiff", {"name":"activeCenterDiff"}],
		//["driveModes", {"name":"centerLock"}],
	],
	"activeCenterDiff":{
		"transferType":"active",
		"transfercaseName":"transfercase",
		"lockMap":{
			"minLockCoef":"$minLock_C"
			"throttleTravel":"$lockThrottleTravel_C"
			"brakeTravel":"$lockBrakeTravel_C"
			"throttleStart":"$lockThrottleStart_C"
			"brakeStart":"$lockBrakeStart_C"
			"steeringLockCut":"$steeringLockCut_C"
			"speedMapFactor":"$speedMapFactor_C"
			"lbThreshold":"$leftAStart_C"
			"lbThrottleGain":"$leftThrottleGain_C"
			"lbBrakeGain":"$leftBrakeGain_C"
			"coastStart":0.05
			"rearBias":"$torquesplit"
			"hbRelease":"$hbRelease"
			"preloadMultiplier":"$preloadMultiplier_C"
			"basePreload":"$=20*$components.diff.finalDrive"
		}
	},
	"centerLock": {
		"enabledModes":["1", "2", "3", "4"],
		"defaultMode": "2",
		"modes": {
			"1": {
				"name": "Center Lock 1",
				"order": 1,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLockCoef":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_open"}]
				]
			},
			"2": {
				"name": "Center Lock 2",
				"order": 2,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLockCoef":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_lsd"}]
				]
			},
			"3": {
				"name": "Center Lock 3",
				"order": 3,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLockCoef":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_closed"}]
				]
			},
			"4": {
				"name": "Center Lock 4",
				"order": 4,
				"settings": [
					["type"],
					["controller", {"controllerName":"eCenterDiff", "minLockCoef":"1"}],
					["simpleControlButton", {"buttonId":"throttle", "uiName":"Throttle Lock","icon":"powertrain_differential_lsd_active"}]
				]
			},
		}
	},
	"powertrain" : [
		["type", "name", "inputName", "inputIndex"],
		["differential", "transfercase", "gearbox", 1, {"gearRatio":"$=$components.diff.finalDrive", "deformGroups":["transfercase"], "diffType":"lsd", "lsdPreload":0, "lsdLockCoef":0.5, "lsdRevLockCoef":0.38, "diffTorqueSplit":0.5, "friction":0.36, "dynamicFriction":0.00028, "torqueLossCoef": 0.018, "uiName":"Center Diff", "defaultVirtualInertia":0.25}]  //overridden by Lua
	],
	"nodes": [
		["id", "posX", "posY", "posZ"],
		{"frictionCoef":0.5},
		{"nodeMaterial":"|NM_METAL"},
		{"collision":true},
		{"selfCollision":true},
		{"nodeWeight":22},
		//--Transfer Case--
		{"group":["Astral_transfercase"]},
		["tra", 0.022, -1.028, 0.2],
	],
	"beams": [
		["id1:", "id2:"],
		{"deformLimitExpansion":1.2},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		//--Transfer Case--
		{"breakGroup":""}
		{"beamSpring":8501000,"beamDamp":850},
		{"beamDeform":35000,"beamStrength":"FLT_MAX"},
		{"deformGroup":"transfercase", "deformationTriggerRatio":0.001},
		["tra", "eg0"],
		["tra", "eg1"],
		["tra", "eg2"],
		["tra", "eg3"],
		["tra", "eg6"],
		["tra", "eg7"],
		["tra", "ftral"],
		["tra", "ftrar"],
		{"deformGroup":"", "deformationTriggerRatio":0},
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
		{"beamLimitSpring":"","beamLimitDamp":"","beamLimitDampRebound":""},
	],
},
