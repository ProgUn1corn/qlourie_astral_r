{
"Astral_shim_F_rally2_tarmac_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_F_rally2_tarmac",
	"slots2" : [
		["name"        , "allowTypes"    , "denyTypes", "default"               , "description"],
		["Astral_lrs_F", ["Astral_lrs_F"], []         , "Astral_lrs_F_rally2_no", "LRS Valve Blocker", {"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$velocitySplit_F", "range", "m/s", "Suspension - Dampers and Springs", 0.35, 0.2, 0.5, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.05,"subCategory":"Front Damper Internal"}],
		["$LRSShim_F", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Front Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"FrontLRS"}],
	],
	"FrontLRS": {
		"loads": [
			["name", "LRSName",  "LRSp",			   "LRSf",   "DSVName", "DSVp", "DSVf", "blocker"]
			["FR",   "LRS_FR",   "$=0.1214+$LRSShim_F", 0.588,   "DSV_FR",  0.114,   0.80,  "$=$components.dampers.blocker_F"]
			["FL",   "LRS_FL",   "$=0.1214+$LRSShim_F", 0.588,   "DSV_FL",  0.114,   0.80,  "$=$components.dampers.blocker_F"]
		],
		"dampers": [
			["name", "beamName"]
			["FR",   "damper_FR"]
			["FL",   "damper_FL"]
		],
		"damping":[
			["name", "beamDamp", "beamDampFast", "beamDampRebound", "beamDampReboundFast", "beamDampVelocitySplit"                                         , "beamDampVelocitySplitRebound"],
			["FR"  , "$bump1_F", "$bump2_F"    , "$rebound_F"     , "$=$rebound_F*1.05"  , "$=$velocitySplit_F+($bump2_F-3600)/32000-($bump1_F-2800)/20000", 0.46],
			["FL"  , "$bump1_F", "$bump2_F"    , "$rebound_F"     , "$=$rebound_F*1.05"  , "$=$velocitySplit_F+($bump2_F-3600)/32000-($bump1_F-2800)/20000", 0.46],
		]
	},
	"components":{
		"dampers":{
			"bump1_F":"$=4800+2000*$dampClicks_bump_F/$components.dampers.bumpClicks_F",
			"bump2_F":"$=3600+3200*$dampClicks_bump_F_fast",
			"rebound_F":"$=4800+2000*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
		},
	},
},
