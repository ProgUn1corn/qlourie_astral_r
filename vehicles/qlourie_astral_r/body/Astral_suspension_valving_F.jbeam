"Astral_valving_F_gravel_a": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":3200,
	},
	"slotType":"Astral_valving_F_gravel",
	"components":{
		"dampers":{
			"bump1_F":"$=3700+2400*$dampClicks_bump_F/$components.dampers.bumpClicks_F",
			"bump2_F":"$=(3700+2400*$dampClicks_bump_F/$components.dampers.bumpClicks_F)*(0.9+0.12*$dampClicks_bump_F/$components.dampers.bumpClicks_F)",
			"HSbump_F":"$=1000+3000*$dampClicks_bump_F_fast",
			"rebound_F":"$=3015+1800*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
			"HSrebound_F":"$=(3015+1800*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)*(0.9+0.16*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)",
			"bumpKnee_F":"$=0.17+0.04*$dampClicks_bump_F/$components.dampers.bumpClicks_F+0.02*min($dampClicks_bump_F/$components.dampers.bumpClicks_F+0.5,0)",
			"HSbumpKnee_F":"$=0.58+0.04*$dampClicks_bump_F_fast",
			"reboundKnee_F":"$=0.4+0.1*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
			"LRS_F":0.851,
		},
	},
},
