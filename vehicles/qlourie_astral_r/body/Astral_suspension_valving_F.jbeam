		["Astral_shimstacks_F_tarmac_l",["Astral_shimstacks_F_tarmac_l"],[],"Astral_shimstacks_F_tarmac_l_l","Shim Stacks",{"coreSlot":true}],
		["Astral_lrs_F",["Astral_lrs_F"],[],"Astral_lrs_F_no","LRS Valve Blocker",{"coreSlot":true}],
	],
