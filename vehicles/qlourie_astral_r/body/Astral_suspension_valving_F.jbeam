"Astral_shim_F_rx_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_F_rx",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_lrs_F",["Astral_lrs_F"],[],"Astral_lrs_F_no","LRS Valve Blocker",{"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$LRSShim_F", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Front Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"FrontLRS"}],
	],
	"FrontLRS": {
	   "loads": [
			["name", "LRSName", "LRSp"               , "LRSf", "blocker"],
			["FR"  , "LRS_FR" , "$=0.1128+$LRSShim_F", 0.7   , "$=$components.dampers.blocker_F"],
			["FL"  , "LRS_FL" , "$=0.1128+$LRSShim_F", 0.7   , "$=$components.dampers.blocker_F"],
		],
		"dampers": [
			["name", "beamName"]
			["FR"  , "damper_FR"]
			["FL"  , "damper_FL"]
		],
		"damping":[
			["name", "beamDamp", "beamDampFast", "beamDampRebound", "beamDampReboundFast", "beamDampVelocitySplit", "beamDampVelocitySplitRebound"],
			["FR"  , "$bump1_F", "$bump2_F"    , "$rebound_F"     , "$=$rebound_F*0.95"  , 0.48                   , 0.65],
			["FL"  , "$bump1_F", "$bump2_F"    , "$rebound_F"     , "$=$rebound_F*0.95"  , 0.48                   , 0.65],
		]
	},
	"components": {
		"dampers": {
			"bumpBase_F":4210,
			"bumpExtra_F":3600,
			"reboundBase_F":4210,
		},
	},
},
"Astral_shim_F_rx3_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":3200,
	},
	"slotType" : "Astral_shim_F_rx",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_lrs_F",["Astral_lrs_F"],[],"Astral_lrs_F_no","LRS Valve Blocker",{"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_bump_F", "range", "c", "Suspension - Dampers and Springs", 3050, 2090, 4010, "LS Bump", "Low speed bump damping controls car dynamics and small bump absorption", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Front Damper - 3-Way"}],
		["$dampRate_bump_F_fast", "range", "C", "Suspension - Dampers and Springs", 4200, 2600, 5800, "HS Bump", "High speed bump damping controls jump and big bump absorption", {"stepDis":1,"minDis":-20,"maxDis":0,"subCategory":"Front Damper - 3-Way"}],
		["$dampRate_rebound_F", "range", "R", "Suspension - Dampers and Springs", 3050, 2090, 4010, "Rebound", "Rebound damping controls how fast the damper extends", {"stepDis":1,"minDis":-48,"maxDis":0,"subCategory":"Front Damper - 3-Way"}],
		["$velocitySplit_F", "range", "m/s", "Suspension - Dampers and Springs", 0.42, 0.15, 0.69, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.09,"subCategory":"Front Damper Internal"}],
		["$LRSShim_F", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Front Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"FrontLRS"}],
	],
	"FrontLRS": {
	   "loads": [
			["name", "LRSName", "LRSp"               , "LRSf", "blocker"],
			["FR"  , "LRS_FR" , "$=0.1128+$LRSShim_F", 0.521 , "$=$components.dampers.blocker_F"],
			["FL"  , "LRS_FL" , "$=0.1128+$LRSShim_F", 0.521 , "$=$components.dampers.blocker_F"],
		],
		"dampers": [
			["name", "beamName"]
			["FR",   "damper_FR"]
			["FL",   "damper_FL"]
		],
		"damping":[
			["name", "beamDamp"        , "beamDampFast"         , "beamDampRebound"    , "beamDampReboundFast"      , "beamDampVelocitySplit"                                                             , "beamDampVelocitySplitRebound"],
			["FR"  , "$dampRate_bump_F", "$dampRate_bump_F_fast", "$dampRate_rebound_F", "$=$dampRate_rebound_F*0.9", "$=$velocitySplit_F+($dampRate_bump_F_fast-2600)/16000-($dampRate_bump_F-2090)/9600", 0.65],
			["FL"  , "$dampRate_bump_F", "$dampRate_bump_F_fast", "$dampRate_rebound_F", "$=$dampRate_rebound_F*0.9", "$=$velocitySplit_F+($dampRate_bump_F_fast-2600)/16000-($dampRate_bump_F-2090)/9600", 0.65],
		]
	}
},

