		"dampers":{
			"bump1_F":"$=5250+3600*$dampClicks_bump_F/$components.dampers.bumpClicks_F",
			"bump2_F":"$=(5250+3600*$dampClicks_bump_F/$components.dampers.bumpClicks_F)*(0.88-0.12*$dampClicks_bump_F/$components.dampers.bumpClicks_F)",
			"rebound_F":"$=4800+3000*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
			"HSrebound_F":"$=(4800+3000*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)*(0.8-0.12*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)",
			"bumpKnee_F":0.08,
			"HSbumpKnee_F":"$=0.29+0.02*$dampClicks_bump_F_fast",
			"reboundKnee_F":"$=0.27+0.04*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
			"LRS_F":"$=0.599-0.1-0.2*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
		},
	},
},
