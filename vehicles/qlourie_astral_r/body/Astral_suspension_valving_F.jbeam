"Astral_shimstacks_F_tarmac_l_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":0,
	},
	"slotType":"Astral_shimstacks_F_tarmac_l",
	"beams": [
		["id1:", "id2:"],
		{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":0,"beamDamp":0},
		{"beamLimitSpring":0,"beamLimitDamp":0},
		{"optional":false},
		// Beam strength is inherited from the damper assembly slot.
		["fh2r","fs1r", {
			"name":"damper_FR_HS",
			"breakGroup":"damper_FR",
			"beamDampRebound":0,
			"beamDampVelocitySplit":"$=$components.dampers.HSbumpKnee_F",
			"beamDampFast":2000,
			"beamDampReboundFast":0,
			"dampCutoffHz":500}
		],
		["fh2l","fs1l", {
			"name":"damper_FL_HS",
			"breakGroup":"damper_FL",
			"beamDampRebound":0,
			"beamDampVelocitySplit":"$=$components.dampers.HSbumpKnee_F",
			"beamDampFast":2000,
			"beamDampReboundFast":0,
			"dampCutoffHz":500}
		],
		// Optional test-rig beam follows the selected front shim stack.
		["ds1","dm1", {
			"name":"HSshim_debug",
			"optional":true,
			"breakGroup":"",
			"beamDeform":65000,"beamStrength":125000,
			"beamDampRebound":0,
			"beamDampVelocitySplit":"$=$components.dampers.HSbumpKnee_F",
			"beamDampFast":2000,
			"beamDampReboundFast":0,
			"dampCutoffHz":500}
		],
		{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
		{"beamSpring":false,"beamDamp":false},
	],

},
