			"HSbump_F":"$=250+3000*$dampClicks_bump_F_fast",
			"rebound_F":"$=5100+3000*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
			"HSrebound_F":"$=(5100+3000*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)*(0.8-0.12*$dampClicks_rebound_F/$components.dampers.reboundClicks_F)",
			"bumpKnee_F":0.08,
			"HSbumpKnee_F":"$=0.34+0.02*$dampClicks_bump_F_fast",
			"reboundKnee_F":"$=0.27+0.04*$dampClicks_rebound_F/$components.dampers.reboundClicks_F",
		},
	},
},
