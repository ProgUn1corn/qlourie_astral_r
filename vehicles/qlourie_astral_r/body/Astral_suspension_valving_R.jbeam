"Astral_shim_R_rx_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_rx",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_lrs_R",["Astral_lrs_R"],[],"Astral_lrs_R_no","LRS Valve Blocker",{"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$lrsShim_R", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Rear Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"RearLRS"}],
	],
	"RearLRS": {
		"loads": [
			["name", "LRSName", "LRSp"               , "LRSf", "blocker"],
			["RR"  , "LRS_RR" , "$=0.1218+$lrsShim_R", 0.7   , "$=$components.dampers.blocker_R"],
			["RL"  , "LRS_RL" , "$=0.1218+$lrsShim_R", 0.7   , "$=$components.dampers.blocker_R"],
		],
		"dampers": [
			["name", "beamName"]
			["RR"  , "damper_RR"]
			["RL"  , "damper_RL"]
		],
		"damping":[
			["name", "beamDamp", "beamDampFast", "beamDampRebound", "beamDampReboundFast", "beamDampVelocitySplit", "beamDampVelocitySplitRebound"],
			["RR"  , "$bump1_R", "$bump2_R"    , "$rebound_R"     , "$=$rebound_R*0.95"  , 0.48                   , 0.65],
			["RL"  , "$bump1_R", "$bump2_R"    , "$rebound_R"     , "$=$rebound_R*0.95"  , 0.48                   , 0.65],
		]
	},
	"components": {
		"dampers": {
			"bumpBase_R":4210,
			"bumpExtra_R":3600,
			"reboundBase_R":4210,
		},
	},
},
"Astral_shim_R_rx3_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_rx",
	"slots2": [
		["name", "allowTypes", "denyTypes", "default", "description"],
		["Astral_lrs_R",["Astral_lrs_R"],[],"Astral_lrs_R_no","LRS Valve Blocker",{"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$dampRate_bump_R", "range", "c", "Suspension - Dampers and Springs", 3050, 2090, 4010, "LS Bump", "Low speed bump damping controls car dynamics and small bump absorption", {"stepDis":1,"minDis":-16,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$dampRate_bump_R_fast", "range", "C", "Suspension - Dampers and Springs", 3400, 1800, 5000, "HS Bump", "High speed bump damping controls jump and big bump absorption", {"stepDis":1,"minDis":-20,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$dampRate_rebound_R", "range", "R", "Suspension - Dampers and Springs", 3050, 2090, 4010, "Rebound", "Rebound damping controls how fast the damper extends", {"stepDis":1,"minDis":-48,"maxDis":0,"subCategory":"Rear Damper - 3-Way"}],
		["$velocitySplit_R", "range", "m/s", "Suspension - Dampers and Springs", 0.42, 0.15, 0.69, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.09,"subCategory":"Rear Damper Internal"}],
		["$lrsShim_R", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Rear Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"RearLRS"}],
	],
	"RearLRS": {
		"loads": [
			["name", "LRSName", "LRSp"               , "LRSf", "blocker"],
			["RR"  , "LRS_RR" , "$=0.1218+$lrsShim_R", 0.499 , "$=$components.dampers.blocker_R"],
			["RL"  , "LRS_RL" , "$=0.1218+$lrsShim_R", 0.499 , "$=$components.dampers.blocker_R"],
		],
		"dampers": [
			["name", "beamName"]
			["RR",   "damper_RR"]
			["RL",   "damper_RL"]
		],
		"damping":[
			["name", "beamDamp"        , "beamDampFast"         , "beamDampRebound"    , "beamDampReboundFast"      , "beamDampVelocitySplit"                                                             , "beamDampVelocitySplitRebound"],
			["RR"  , "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.9", "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2090)/9600", 0.65],
			["RL"  , "$dampRate_bump_R", "$dampRate_bump_R_fast", "$dampRate_rebound_R", "$=$dampRate_rebound_R*0.9", "$=$velocitySplit_R+($dampRate_bump_R_fast-2600)/16000-($dampRate_bump_R-2090)/9600", 0.65],
		]
	},
},

