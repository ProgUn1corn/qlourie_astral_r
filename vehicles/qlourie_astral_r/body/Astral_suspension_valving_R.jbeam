{
"Astral_shim_R_rally2_tarmac_l": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-B",
		"value":3200,
	},
	"slotType" : "Astral_shim_R_rally2_tarmac",
	"slots2" : [
		["name"        , "allowTypes"    , "denyTypes", "default"               , "description"],
		["Astral_lrs_R", ["Astral_lrs_R"], []         , "Astral_lrs_R_rally2_no", "LRS Valve Blocker", {"coreSlot":true}],
	],
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$velocitySplit_R", "range", "m/s", "Suspension - Dampers and Springs", 0.35, 0.2, 0.5, "Neutral Velocity Split", "Velocity split when clicks are at default", {"stepDis":0.05,"subCategory":"Rear Damper Internal"}],
		["$LRSShim_R", "range", "mm", "Suspension - Dampers and Springs", 0, -0.001, 0.001, "LRS Shim", "Controls the open threshold of LRS", {"stepDis":0.5,"minDis":1,"maxDis":3,"subCategory":"Rear Damper Internal"}],
	],
	"controller": [
		["fileName"],
		["LRS2", {"name":"RearLRS"}],
	],
	"RearLRS": {
		"loads": [
			["name", "LRSName",  "LRSp",			   "LRSf",   "DSVName", "DSVp", "DSVf", "blocker"]
			["RR",   "LRS_RR",   "$=0.1214+$LRSShim_R", 0.499,   "DSV_RR",  0.1125, 0.80,   "$=$components.dampers.blocker_R"]
			["RL",   "LRS_RL",   "$=0.1214+$LRSShim_R", 0.499,   "DSV_RL",  0.1125, 0.80,   "$=$components.dampers.blocker_R"]
		],
		"dampers": [
			["name", "beamName"]
			["RR",   "damper_RR"]
			["RL",   "damper_RL"]
		],
		"damping":[
			["name", "beamDamp", "beamDampFast", "beamDampRebound", "beamDampReboundFast", "beamDampVelocitySplit"                                         , "beamDampVelocitySplitRebound"],
			["RR"  , "$bump1_R", "$bump2_R"    , "$rebound_R"     , "$=$rebound_R*1.05"  , "$=$velocitySplit_R+($bump2_R-3600)/32000-($bump1_R-2800)/20000", 0.46],
			["RL"  , "$bump1_R", "$bump2_R"    , "$rebound_R"     , "$=$rebound_R*1.05"  , "$=$velocitySplit_R+($bump2_R-3600)/32000-($bump1_R-2800)/20000", 0.46],
		]
	},
	"components":{
		"dampers":{
			"bump1_R":"$=4800+2000*$dampClicks_bump_R/$components.dampers.bumpClicks_R",
			"bump2_R":"$=3600+3200*$dampClicks_bump_R_fast",
			"rebound_R":"$=4800+2000*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
		},
	},
},
