"Astral_valving_R_gravel_a": {
	"information":{
		"authors":"Un1corn",
		"name":"Type-A",
		"value":3200,
	},
	"slotType":"Astral_valving_R_gravel",
	"components":{
		"dampers":{
			"bump1_R":"$=3700+2400*$dampClicks_bump_R/$components.dampers.bumpClicks_R",
			"bump2_R":"$=(3700+2400*$dampClicks_bump_R/$components.dampers.bumpClicks_R)*(0.9+0.12*$dampClicks_bump_R/$components.dampers.bumpClicks_R)",
			"HSbump_R":"$=1000+3000*$dampClicks_bump_R_fast",
			"rebound_R":"$=3015+1800*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
			"HSrebound_R":"$=(3015+1800*$dampClicks_rebound_R/$components.dampers.reboundClicks_R)*(0.9+0.16*$dampClicks_rebound_R/$components.dampers.reboundClicks_R)",
			"bumpKnee_R":"$=0.17+0.04*$dampClicks_bump_R/$components.dampers.bumpClicks_R+0.02*min($dampClicks_bump_R/$components.dampers.bumpClicks_R+0.5,0)",
			"HSbumpKnee_R":"$=0.58+0.04*$dampClicks_bump_R_fast",
			"reboundKnee_R":"$=0.4+0.1*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
			"LRS_R":0.821,
		},
	},
},
