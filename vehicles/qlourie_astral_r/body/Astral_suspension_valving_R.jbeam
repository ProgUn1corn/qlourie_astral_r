			"HSbump_R":0,
			"rebound_R":"$=2835+1800*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
			"HSrebound_R":"$=(2835+1800*$dampClicks_rebound_R/$components.dampers.reboundClicks_R)*1.1",
			"bumpKnee_R":0.55,
			"HSbumpKnee_R":0.55,
			"reboundKnee_R":1.25,
