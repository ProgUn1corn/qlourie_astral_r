			"HSbump_R":"$=250+3000*$dampClicks_bump_R_fast",
			"rebound_R":"$=5100+3000*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
			"HSrebound_R":"$=(5100+3000*$dampClicks_rebound_R/$components.dampers.reboundClicks_R)*(0.8-0.12*$dampClicks_rebound_R/$components.dampers.reboundClicks_R)",
			"bumpKnee_R":0.08,
			"HSbumpKnee_R":"$=0.34+0.02*$dampClicks_bump_R_fast",
			"reboundKnee_R":"$=0.27+0.04*$dampClicks_rebound_R/$components.dampers.reboundClicks_R",
		},
	},
},
