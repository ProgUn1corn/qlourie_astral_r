{
"Astral_power_steering": {
	"information":{
		"authors":"BeamNG",
		"name":"Power Steering",
		"value":250,
	},
	"slotType" : "Astral_power_steering",
	"variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$pwrStrMul", "range", "", "Steering", 1, 0.5, 1.5, "Hydraulic Pump Strength", "The constant power acrossing whole power steering system", {"subCategory":"ui.vehicleconfig.slot.description.Power Steering", "minDis":50,"maxDis":150}],
	],
	"controller": [
		["fileName"],
		["powerSteering", {"strengthFast":0.90, "strengthSlow":0.30, "speedSlow": 4, "speedFast": 38, "constantOffset":"$=-0.05*$pwrStrMul"}]
	]
}
}
